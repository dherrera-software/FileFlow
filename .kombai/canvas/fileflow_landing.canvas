-kid=\"1-3-1-1-2-2-2-3-1\" data-name=\"email contact link\" href=\"mailto:hello@fileflow.app\">hello@fileflow.app</a></li>\n</ul>\n</div>\n</div>\n</div>\n<div class=\"mt-9 flex flex-wrap items-center justify-between gap-3 border-t border-[#09090B1A] pt-4 text-[11px] uppercase tracking-[0.13em] text-[#71717A]\" data-kid=\"1-3-1-2\" data-name=\"footer bottom bar\">\n<span data-kid=\"1-3-1-2-1\" data-name=\"copyright notice\">© 2026 FileFlow</span>\n<span class=\"inline-flex items-center gap-2\" data-kid=\"1-3-1-2-2\" data-name=\"engine status indicator\">\n<span class=\"h-1.5 w-1.5 bg-[#09090B4D]\" data-kid=\"1-3-1-2-2-1\" data-name=\"status dot\"></span>\n          Conversion engine not connected\n        </span>\n</div>\n</div>\n</footer>\n</div>",
