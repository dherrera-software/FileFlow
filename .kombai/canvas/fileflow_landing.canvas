        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n</style>\n<div class=\"relative min-h-screen overflow-x-clip bg-white text-[#09090B] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: Inter, ui-sans-serif, system-ui, sans-serif;\">\n<div class=\"pointer-events-none absolute inset-x-0 top-0 h-[660px] bg-[radial-gradient(52%_50%_at_50%_18%,rgba(109,94,245,0.10),rgba(109,94,245,0.03)_56%,rgba(109,94,245,0)_78%)]\" data-kid=\"1-1\" data-name=\"decorative top radial gradient glow\"></div>\n<!-- Floating pill navbar -->\n<div class=\"relative px-6 pt-6\" data-kid=\"1-2\" data-name=\"navbar padding wrapper\">\n<header class=\"mx-auto flex max-w-[1004px] items-center gap-8 rounded-full border border-[#E4E4E7] bg-white/75 py-2.5 pl-5 pr-2.5 shadow-[0_1px_2px_rgba(9,9,11,0.04),0_18px_40px_-28px_rgba(9,9,11,0.35)] backdrop-blur-xl\" data-kid=\"1-2-1\" data-name=\"floating pill navigation bar\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-1\" data-name=\"brand logo link\" href=\"#top\">\n<span aria-hidden=\"true\" class=\"relative block h-[21px] w-[21px]\" data-kid=\"1-2-1-1-1\" data-name=\"interlocking rounded squares logo icon\">\n<span class=\"absolute left-0 top-[3px] block h-[15px] w-[12px] rounded-[5px] border border-[#09090B4D]\" data-kid=\"1-2-1-1-1-1\" data-name=\"logo rear square outline\"></span>\n<span class=\"absolute left-[8px] top-0 block h-[15px] w-[12px] rounded-[5px] border-[1.5px] border-[#6D5EF5]\" data-kid=\"1-2-1-1-1-2\" data-name=\"logo front purple square outline\"></span>\n</span>\n<span class=\"text-[14.5px] font-semibold tracking-[-0.01em]\" data-kid=\"1-2-1-1-2\" data-name=\"brand name text\">FileFlow</span>\n</a>\n<nav aria-label=\"Main\" class=\"hidden items-center gap-1 md:flex\" data-kid=\"1-2-1-2\" data-name=\"main site navigation menu\">\n<a aria-current=\"page\" class=\"rounded-full bg-[#6D5EF50F] px-3.5 py-1.5 text-[13px] font-medium text-[#4B3DD4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-1-2-1\" data-name=\"nav home link (active page)\" href=\"#top\">Home</a>\n<a class=\"rounded-full px-3.5 py-1.5 text-[13px] text-[#71717A] transition-colors hover:bg-[#6D5EF50A] hover:text-[#4B3DD4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-1-2-2\" data-name=\"nav converters link\" href=\"#converters\">Converters</a>\n<a class=\"rounded-full px-3.5 py-1.5 text-[13px] text-[#71717A] transition-colors hover:bg-[#6D5EF50A] hover:text-[#4B3DD4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-1-2-3\" data-name=\"nav how-it-works link\" href=\"#how-it-works\">How it works</a>\n</nav>\n<div class=\"ml-auto flex items-center gap-3\" data-kid=\"1-2-1-3\" data-name=\"nav right-side action cluster\">\n<span class=\"hidden text-[12.5px] text-[#71717A] lg:block\" data-kid=\"1-2-1-3-1\" data-name=\"nav free-no-account tagline\">Free, no account</span>\n<a class=\"rounded-full bg-[#09090B] px-4 py-2 text-[12.5px] font-medium text-white transition-colors hover:bg-[#27272A] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-1-3-2\" data-name=\"nav start-converting call-to-action button\" href=\"#convert\">Start converting</a>\n</div>\n</header>\n</div>\n<main class=\"relative\" data-kid=\"1-3\" data-name=\"main content region\" id=\"top\">\n<!-- Hero + frosted plate -->\n<section class=\"mx-auto max-w-[1120px] px-6 pb-14 pt-[76px]\" data-kid=\"1-3-1\" data-name=\"hero section\">\n<div class=\"mx-auto max-w-[780px] text-center\" data-kid=\"1-3-1-1\" data-name=\"hero text block\">\n<p class=\"text-[10.5px] font-semibold uppercase tracking-[0.2em] text-[#5B4CE0]\" data-kid=\"1-3-1-1-1\" data-name=\"hero eyebrow label\">Simple file conversion</p>\n<h1 class=\"mx-auto mt-5 max-w-[17ch] text-[44px] font-medium leading-[1.06] tracking-[-0.04em] text-balance sm:text-[60px]\" data-kid=\"1-3-1-1-2\" data-name=\"hero headline\">\n          Your files, in the right format.\n        </h1>\n<p class=\"mx-auto mt-5 max-w-[52ch] text-[16px] leading-[1.62] text-[#52525B]\" data-kid=\"1-3-1-1-3\" data-name=\"hero subheadline description\">\n          One drop, one target, one file back. FileFlow only offers conversions that exist for the format you bring.\n        </p>\n</div>\n<div class=\"relative mx-auto mt-11 max-w-[700px]\" data-kid=\"1-3-1-2\" data-name=\"hero frosted card wrapper\">\n<div class=\"rounded-xl border border-[#E4E4E7] bg-white/70 p-2.5 shadow-[0_1px_1px_rgba(9,9,11,0.03),0_28px_60px_-34px_rgba(9,9,11,0.35)] backdrop-blur-xl\" data-kid=\"1-3-1-2-1\" data-name=\"frosted glass upload plate\">\n<section aria-labelledby=\"plate-upload-label\" class=\"rounded-[10px] bg-white/60\" data-kid=\"1-3-1-2-1-1\" data-name=\"file upload drop panel\" id=\"convert\">\n<h2 class=\"sr-only\" data-kid=\"1-3-1-2-1-1-1\" data-name=\"upload panel screen-reader label\" id=\"plate-upload-label\">Upload a file to convert</h2>\n<div class=\"flex flex-col items-center rounded-full border border-[#E4E4E7] bg-white px-8 py-10 text-center\" data-kid=\"1-3-1-2-1-1-2\" data-name=\"drag-and-drop file aperture\">\n<span class=\"inline-block text-[24px] leading-none text-[#6D5EF5]\" data-kid=\"1-3-1-2-1-1-2-1\" data-name=\"upload icon wrapper\"><i aria-hidden=\"true\" class=\"icon-file-up\" data-kid=\"1-3-1-2-1-1-2-1-1\" data-name=\"upload file icon\"></i></span>\n<p class=\"mt-4 text-[15.5px] font-medium\" data-kid=\"1-3-1-2-1-1-2-2\" data-name=\"drop file instruction text\">Drop a file into the aperture</p>\n<p class=\"mt-1.5 max-w-[40ch] text-[13px] leading-[1.55] text-[#71717A]\" data-kid=\"1-3-1-2-1-1-2-3\" data-name=\"drop file alternative instruction\">\n                or choose one from your device — it stays on this machine until you convert.\n              </p>\n<button class=\"mt-5 rounded-full border border-[#6D5EF5] bg-[#6D5EF5] px-5 py-2.5 text-[13px] font-medium text-white shadow-[0_10px_24px_-14px_rgba(109,94,245,0.9)] transition-colors hover:border-[#5B4CE0] hover:bg-[#5B4CE0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4B3DD4]\" data-kid=\"1-3-1-2-1-1-2-4\" data-name=\"choose file button\" type=\"button\">\n                Choose file\n              </button>\n</div>\n<div class=\"flex flex-wrap items-center justify-center gap-1.5 px-5 pb-3.5 pt-4\" data-kid=\"1-3-1-2-1-1-3\" data-name=\"supported formats badge row\">\n<span class=\"mr-1 text-[11.5px] text-[#71717A]\" data-kid=\"1-3-1-2-1-1-3-1\" data-name=\"accepts label\">Accepts</span>\n<span class=\"rounded-full bg-blue-50 px-2 py-0.5 text-[10.5px] font-semibold tracking-[0.06em] text-blue-700\" data-kid=\"1-3-1-2-1-1-3-2\" data-name=\"DOCX format badge\">DOCX</span>\n<span class=\"rounded-full bg-red-50 px-2 py-0.5 text-[10.5px] font-semibold tracking-[0.06em] text-red-700\" data-kid=\"1-3-1-2-1-1-3-3\" data-name=\"PDF format badge\">PDF</span>\n<span class=\"rounded-full bg-amber-50 px-2 py-0.5 text-[10.5px] font-semibold tracking-[0.06em] text-amber-700\" data-kid=\"1-3-1-2-1-1-3-4\" data-name=\"JPG format badge\">JPG</span>\n<span class=\"rounded-full bg-amber-50 px-2 py-0.5 text-[10.5px] font-semibold tracking-[0.06em] text-amber-700\" data-kid=\"1-3-1-2-1-1-3-5\" data-name=\"JPEG format badge\">JPEG</span>\n<span class=\"rounded-full bg-teal-50 px-2 py-0.5 text-[10.5px] font-semibold tracking-[0.06em] text-teal-700\" data-kid=\"1-3-1-2-1-1-3-6\" data-name=\"PNG format badge\">PNG</span>\n<span class=\"rounded-full bg-emerald-50 px-2 py-0.5 text-[10.5px] font-semibold tracking-[0.06em] text-emerald-700\" data-kid=\"1-3-1-2-1-1-3-7\" data-name=\"XLSX format badge\">XLSX</span>\n<span class=\"rounded-full bg-orange-50 px-2 py-0.5 text-[10.5px] font-semibold tracking-[0.06em] text-orange-700\" data-kid=\"1-3-1-2-1-1-3-8\" data-name=\"PPTX format badge\">PPTX</span>\n<span class=\"ml-1 text-[11.5px] text-[#A1A1AA]\" data-kid=\"1-3-1-2-1-1-3-9\" data-name=\"file size limit note\">up to 25 MB</span>\n</div>\n</section>\n</div>\n</div>\n</section>\n<!-- Popular conversions: pill chips with semantic formats -->\n<section class=\"mx-auto max-w-[1120px] px-6 pb-16\" data-kid=\"1-3-2\" data-name=\"popular conversions section\" id=\"converters\">\n<div class=\"flex flex-wrap items-baseline justify-between gap-3 border-t border-[#E4E4E7] pt-7\" data-kid=\"1-3-2-1\" data-name=\"section header row\">\n<h2 class=\"text-[19px] font-semibold tracking-[-0.015em]\" data-kid=\"1-3-2-1-1\" data-name=\"section heading\">Popular conversions</h2>\n<p class=\"text-[12.5px] text-[#71717A]\" data-kid=\"1-3-2-1-2\" data-name=\"section helper text\">Tap one to set the target in the drop card.</p>\n</div>\n<ul class=\"mt-4 flex flex-wrap gap-2.5\" data-kid=\"1-3-2-2\" data-name=\"conversion pill list\">\n<li data-kid=\"1-3-2-2-1\" data-name=\"conversion pill list item\">\n<a class=\"group inline-flex items-center gap-1.5 rounded-full border border-[#E4E4E7] bg-white py-1 pl-1 pr-3 transition-colors hover:border-[#6D5EF5] hover:bg-[#6D5EF505] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-2-2-1-1\" data-name=\"DOCX to PDF conversion link\" href=\"#convert\">\n<span class=\"rounded-full bg-blue-50 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.06em] text-blue-700\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"DOCX source format chip\">DOCX</span>\n<span aria-hidden=\"true\" class=\"text-[11px] text-[#C4C4CC] transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"format conversion arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-3-2-2-1-1-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"rounded-full bg-red-50 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.06em] text-red-700\" data-kid=\"1-3-2-2-1-1-3\" data-name=\"PDF target format chip\">PDF</span>\n</a>\n</li>\n<li data-kid=\"1-3-2-2-2\" data-name=\"conversion pill list item\">\n<a class=\"group inline-flex items-center gap-1.5 rounded-full border border-[#E4E4E7] bg-white py-1 pl-1 pr-3 transition-colors hover:border-[#6D5EF5] hover:bg-[#6D5EF505] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-2-2-2-1\" data-name=\"PDF to DOCX conversion link\" href=\"#convert\">\n<span class=\"rounded-full bg-red-50 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.06em] text-red-700\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"PDF source format chip\">PDF</span>\n<span aria-hidden=\"true\" class=\"text-[11px] text-[#C4C4CC] transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"format conversion arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-3-2-2-2-1-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"rounded-full bg-blue-50 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.06em] text-blue-700\" data-kid=\"1-3-2-2-2-1-3\" data-name=\"DOCX target format chip\">DOCX</span>\n</a>\n</li>\n<li data-kid=\"1-3-2-2-3\" data-name=\"conversion pill list item\">\n<a class=\"group inline-flex items-center gap-1.5 rounded-full border border-[#E4E4E7] bg-white py-1 pl-1 pr-3 transition-colors hover:border-[#6D5EF5] hover:bg-[#6D5EF505] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-2-2-3-1\" data-name=\"JPG to PDF conversion link\" href=\"#convert\">\n<span class=\"rounded-full bg-amber-50 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.06em] text-amber-700\" data-kid=\"1-3-2-2-3-1-1\" data-name=\"JPG source format chip\">JPG</span>\n<span aria-hidden=\"true\" class=\"text-[11px] text-[#C4C4CC] transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-3-2-2-3-1-2\" data-name=\"format conversion arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-3-2-2-3-1-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"rounded-full bg-red-50 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.06em] text-red-700\" data-kid=\"1-3-2-2-3-1-3\" data-name=\"PDF target format chip\">PDF</span>\n</a>\n</li>\n<li data-kid=\"1-3-2-2-4\" data-name=\"conversion pill list item\">\n<a class=\"group inline-flex items-center gap-1.5 rounded-full border border-[#E4E4E7] bg-white py-1 pl-1 pr-3 transition-colors hover:border-[#6D5EF5] hover:bg-[#6D5EF505] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-2-2-4-1\" data-name=\"PDF to JPG conversion link\" href=\"#convert\">\n<span class=\"rounded-full bg-red-50 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.06em] text-red-700\" data-kid=\"1-3-2-2-4-1-1\" data-name=\"PDF source format chip\">PDF</span>\n<span aria-hidden=\"true\" class=\"text-[11px] text-[#C4C4CC] transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-3-2-2-4-1-2\" data-name=\"format conversion arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-3-2-2-4-1-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"rounded-full bg-amber-50 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.06em] text-amber-700\" data-kid=\"1-3-2-2-4-1-3\" data-name=\"JPG target format chip\">JPG</span>\n</a>\n</li>\n<li data-kid=\"1-3-2-2-5\" data-name=\"conversion pill list item\">\n<a class=\"group inline-flex items-center gap-1.5 rounded-full border border-[#E4E4E7] bg-white py-1 pl-1 pr-3 transition-colors hover:border-[#6D5EF5] hover:bg-[#6D5EF505] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-2-2-5-1\" data-name=\"XLSX to PDF conversion link\" href=\"#convert\">\n<span class=\"rounded-full bg-emerald-50 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.06em] text-emerald-700\" data-kid=\"1-3-2-2-5-1-1\" data-name=\"XLSX source format chip\">XLSX</span>\n<span aria-hidden=\"true\" class=\"text-[11px] text-[#C4C4CC] transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-3-2-2-5-1-2\" data-name=\"format conversion arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-3-2-2-5-1-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"rounded-full bg-red-50 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.06em] text-red-700\" data-kid=\"1-3-2-2-5-1-3\" data-name=\"PDF target format chip\">PDF</span>\n</a>\n</li>\n<li data-kid=\"1-3-2-2-6\" data-name=\"conversion pill list item\">\n<a class=\"group inline-flex items-center gap-1.5 rounded-full border border-[#E4E4E7] bg-white py-1 pl-1 pr-3 transition-colors hover:border-[#6D5EF5] hover:bg-[#6D5EF505] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-2-2-6-1\" data-name=\"PPTX to PDF conversion link\" href=\"#convert\">\n<span class=\"rounded-full bg-orange-50 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.06em] text-orange-700\" data-kid=\"1-3-2-2-6-1-1\" data-name=\"PPTX source format chip\">PPTX</span>\n<span aria-hidden=\"true\" class=\"text-[11px] text-[#C4C4CC] transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-3-2-2-6-1-2\" data-name=\"format conversion arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-3-2-2-6-1-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"rounded-full bg-red-50 px-2.5 py-1 text-[10.5px] font-semibold tracking-[0.06em] text-red-700\" data-kid=\"1-3-2-2-6-1-3\" data-name=\"PDF target format chip\">PDF</span>\n</a>\n</li>\n</ul>\n<p class=\"mt-4 text-[12px] text-[#A1A1AA]\" data-kid=\"1-3-2-3\" data-name=\"shared format rules note\">The list is generated from the shared format rules — nothing here is hardcoded twice.</p>\n</section>\n<!-- How it works: zinc band -->\n<section class=\"border-y border-[#E4E4E7] bg-zinc-50\" data-kid=\"1-3-3\" data-name=\"how-it-works section band\" id=\"how-it-works\">\n<div class=\"mx-auto max-w-[1120px] px-6 py-14\" data-kid=\"1-3-3-1\" data-name=\"how-it-works content container\">\n<h2 class=\"text-[19px] font-semibold tracking-[-0.015em]\" data-kid=\"1-3-3-1-1\" data-name=\"section heading\">How it works</h2>\n<div class=\"mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3\" data-kid=\"1-3-3-1-2\" data-name=\"steps grid container\">\n<div class=\"rounded-xl border border-[#E4E4E7] bg-white p-5\" data-kid=\"1-3-3-1-2-1\" data-name=\"step card (drop a file)\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-3-3-1-2-1-1\" data-name=\"step title row\">\n<span class=\"flex h-7 w-7 items-center justify-center rounded-full border border-[#6D5EF526] bg-[#6D5EF50A] text-[11px] font-semibold text-[#4B3DD4]\" data-kid=\"1-3-3-1-2-1-1-1\" data-name=\"step number badge\">1</span>\n<h3 class=\"text-[14px] font-semibold\" data-kid=\"1-3-3-1-2-1-1-2\" data-name=\"step title\">Drop a file</h3>\n</div>\n<p class=\"mt-3 text-[13px] leading-[1.65] text-[#52525B]\" data-kid=\"1-3-3-1-2-1-2\" data-name=\"step description text\">\n              Any of the seven supported formats, up to 25 MB. Rejected files say why in place of the file name.\n            </p>\n</div>\n<div class=\"rounded-xl border border-[#E4E4E7] bg-white p-5\" data-kid=\"1-3-3-1-2-2\" data-name=\"step card (choose the target)\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-3-3-1-2-2-1\" data-name=\"step title row\">\n<span class=\"flex h-7 w-7 items-center justify-center rounded-full border border-[#6D5EF526] bg-[#6D5EF50A] text-[11px] font-semibold text-[#4B3DD4]\" data-kid=\"1-3-3-1-2-2-1-1\" data-name=\"step number badge\">2</span>\n<h3 class=\"text-[14px] font-semibold\" data-kid=\"1-3-3-1-2-2-1-2\" data-name=\"step title\">Choose the target</h3>\n</div>\n<p class=\"mt-3 text-[13px] leading-[1.65] text-[#52525B]\" data-kid=\"1-3-3-1-2-2-2\" data-name=\"step description text\">\n              Only valid targets appear for the detected source format, so an impossible conversion is never offered.\n            </p>\n</div>\n<div class=\"rounded-xl border border-[#E4E4E7] bg-white p-5\" data-kid=\"1-3-3-1-2-3\" data-name=\"step card (convert)\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-3-3-1-2-3-1\" data-name=\"step title row\">\n<span class=\"flex h-7 w-7 items-center justify-center rounded-full border border-[#6D5EF526] bg-[#6D5EF50A] text-[11px] font-semibold text-[#4B3DD4]\" data-kid=\"1-3-3-1-2-3-1-1\" data-name=\"step number badge\">3</span>\n<h3 class=\"text-[14px] font-semibold\" data-kid=\"1-3-3-1-2-3-1-2\" data-name=\"step title\">Convert</h3>\n</div>\n<p class=\"mt-3 text-[13px] leading-[1.65] text-[#52525B]\" data-kid=\"1-3-3-1-2-3-2\" data-name=\"step description text\">\n              Pressing Convert returns a clear notice that the engine is not connected. No progress bar, no dead download.\n            </p>\n</div>\n</div>\n</div>\n</section>\n<!-- Frosted privacy bar -->\n<section class=\"mx-auto max-w-[1120px] px-6 py-14\" data-kid=\"1-3-4\" data-name=\"privacy statement section\">\n<div class=\"rounded-xl border border-[#E4E4E7] bg-[#FAFAFA] p-5 sm:flex sm:items-start sm:gap-5\" data-kid=\"1-3-4-1\" data-name=\"privacy panel card\">\n<span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#6D5EF526] bg-white text-[15px] text-[#6D5EF5]\" data-kid=\"1-3-4-1-1\" data-name=\"shield icon badge circle\">\n<i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-3-4-1-1-1\" data-name=\"shield-check icon\"></i>\n</span>\n<div class=\"mt-3 sm:mt-0\" data-kid=\"1-3-4-1-2\" data-name=\"privacy text block\">\n<h2 class=\"text-[14px] font-semibold\" data-kid=\"1-3-4-1-2-1\" data-name=\"privacy panel heading\">What happens to your file</h2>\n<p class=\"mt-1.5 max-w-[78ch] text-[13px] leading-[1.7] text-[#52525B]\" data-kid=\"1-3-4-1-2-2\" data-name=\"privacy panel description\">\n            Selection and validation run in the browser — no request is made, nothing is stored, and no copy is kept. There is no conversion service connected yet, so the only thing that leaves this page is nothing at all. When the engine is wired in, the file will travel for that job and no longer.\n          </p>\n<ul class=\"mt-3.5 flex flex-wrap items-center gap-2\" data-kid=\"1-3-4-1-2-3\" data-name=\"supported conversion summary list\">\n<li class=\"flex items-center gap-1\" data-kid=\"1-3-4-1-2-3-1\" data-name=\"document formats converting to PDF group\">\n<span class=\"rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-semibold tracking-[0.06em] text-blue-700\" data-kid=\"1-3-4-1-2-3-1-1\" data-name=\"DOCX format chip (privacy)\">DOCX</span>\n<span class=\"rounded-full bg-orange-50 px-2 py-0.5 text-[10px] font-semibold tracking-[0.06em] text-orange-700\" data-kid=\"1-3-4-1-2-3-1-2\" data-name=\"PPTX format chip (privacy)\">PPTX</span>\n<span class=\"rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold tracking-[0.06em] text-emerald-700\" data-kid=\"1-3-4-1-2-3-1-3\" data-name=\"XLSX format chip (privacy)\">XLSX</span>\n<span aria-hidden=\"true\" class=\"px-0.5 text-[11px] text-[#A1A1AA]\" data-kid=\"1-3-4-1-2-3-1-4\" data-name=\"conversion arrow glyph\">→</span>\n<span class=\"rounded-full bg-red-50 px-2 py-0.5 text-[10px] font-semibold tracking-[0.06em] text-red-700\" data-kid=\"1-3-4-1-2-3-1-5\" data-name=\"PDF format chip (privacy)\">PDF</span>\n</li>\n<li class=\"text-[11.5px] text-[#A1A1AA]\" data-kid=\"1-3-4-1-2-3-2\" data-name=\"documents category label\">documents</li>\n<li class=\"flex items-center gap-1\" data-kid=\"1-3-4-1-2-3-3\" data-name=\"PDF conversion targets group\">\n<span class=\"rounded-full bg-red-50 px-2 py-0.5 text-[10px] font-semibold tracking-[0.06em] text-red-700\" data-kid=\"1-3-4-1-2-3-3-1\" data-name=\"PDF format chip (privacy)\">PDF</span>\n<span aria-hidden=\"true\" class=\"px-0.5 text-[11px] text-[#A1A1AA]\" data-kid=\"1-3-4-1-2-3-3-2\" data-name=\"conversion arrow glyph\">→</span>\n<span class=\"rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-semibold tracking-[0.06em] text-blue-700\" data-kid=\"1-3-4-1-2-3-3-3\" data-name=\"DOCX format chip (privacy)\">DOCX</span>\n<span class=\"rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-semibold tracking-[0.06em] text-amber-700\" data-kid=\"1-3-4-1-2-3-3-4\" data-name=\"JPG format chip (privacy)\">JPG</span>\n<span class=\"rounded-full bg-teal-50 px-2 py-0.5 text-[10px] font-semibold tracking-[0.06em] text-teal-700\" data-kid=\"1-3-4-1-2-3-3-5\" data-name=\"PNG format chip (privacy)\">PNG</span>\n</li>\n<li class=\"text-[11.5px] text-[#A1A1AA]\" data-kid=\"1-3-4-1-2-3-4\" data-name=\"scans and exports category label\">scans and exports</li>\n</ul>\n</div>\n</div>\n</section>\n<!-- FAQ: zinc band, two columns -->\n<section class=\"border-y border-[#E4E4E7] bg-zinc-50\" data-kid=\"1-3-5\" data-name=\"FAQ section band\">\n<div class=\"mx-auto max-w-[1120px] px-6 py-14\" data-kid=\"1-3-5-1\" data-name=\"FAQ content container\">\n<h2 class=\"text-[19px] font-semibold tracking-[-0.015em]\" data-kid=\"1-3-5-1-1\" data-name=\"section heading\">Questions</h2>\n<dl class=\"mt-4 grid grid-cols-1 gap-x-10 gap-y-6 sm:grid-cols-2\" data-kid=\"1-3-5-1-2\" data-name=\"FAQ definition list grid\">\n<div class=\"border-t border-[#09090B1A] pt-4\" data-kid=\"1-3-5-1-2-1\" data-name=\"FAQ item\">\n<dt class=\"text-[13.5px] font-medium\" data-kid=\"1-3-5-1-2-1-1\" data-name=\"FAQ question text\">Are my files uploaded anywhere?</dt>\n<dd class=\"mt-1.5 max-w-[46ch] text-[12.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-3-5-1-2-1-2\" data-name=\"FAQ answer text\">No. Format checks happen locally and no request is sent. There is no queue and no stored copy.</dd>\n</div>\n<div class=\"border-t border-[#09090B1A] pt-4\" data-kid=\"1-3-5-1-2-2\" data-name=\"FAQ item\">\n<dt class=\"text-[13.5px] font-medium\" data-kid=\"1-3-5-1-2-2-1\" data-name=\"FAQ question text\">Why doesn't Convert produce a download?</dt>\n<dd class=\"mt-1.5 max-w-[46ch] text-[12.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-3-5-1-2-2-2\" data-name=\"FAQ answer text\">The engine isn't integrated yet. The action reports that in one line instead of faking progress.</dd>\n</div>\n<div class=\"border-t border-[#09090B1A] pt-4\" data-kid=\"1-3-5-1-2-3\" data-name=\"FAQ item\">\n<dt class=\"text-[13.5px] font-medium\" data-kid=\"1-3-5-1-2-3-1\" data-name=\"FAQ question text\">What counts as a valid file?</dt>\n<dd class=\"mt-1.5 max-w-[46ch] text-[12.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-3-5-1-2-3-2\" data-name=\"FAQ answer text\">DOCX, PDF, JPG, JPEG, PNG, XLSX or PPTX up to 25 MB; both rules come from one shared module.</dd>\n</div>\n<div class=\"border-t border-[#09090B1A] pt-4\" data-kid=\"1-3-5-1-2-4\" data-name=\"FAQ item\">\n<dt class=\"text-[13.5px] font-medium\" data-kid=\"1-3-5-1-2-4-1\" data-name=\"FAQ question text\">Do I need an account?</dt>\n<dd class=\"mt-1.5 max-w-[46ch] text-[12.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-3-5-1-2-4-2\" data-name=\"FAQ answer text\">No sign-up and nothing to pay. The format list and the size cap are the only limits.</dd>\n</div>\n</dl>\n</div>\n</section>\n</main>\n<!-- Footer -->\n<footer class=\"bg-white\" data-kid=\"1-4\" data-name=\"site footer\">\n<div class=\"mx-auto max-w-[1120px] px-6 py-11\" data-kid=\"1-4-1\" data-name=\"footer content container\">\n<div class=\"flex flex-col gap-9 md:flex-row md:items-start md:justify-between\" data-kid=\"1-4-1-1\" data-name=\"footer top row\">\n<div class=\"max-w-[300px]\" data-kid=\"1-4-1-1-1\" data-name=\"footer brand block\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-4-1-1-1-1\" data-name=\"footer logo lockup\">\n<span aria-hidden=\"true\" class=\"relative block h-[21px] w-[21px]\" data-kid=\"1-4-1-1-1-1-1\" data-name=\"interlocking rounded squares logo icon\">\n<span class=\"absolute left-0 top-[3px] block h-[15px] w-[12px] rounded-[5px] border border-[#09090B4D]\" data-kid=\"1-4-1-1-1-1-1-1\" data-name=\"logo rear square outline\"></span>\n<span class=\"absolute left-[8px] top-0 block h-[15px] w-[12px] rounded-[5px] border-[1.5px] border-[#6D5EF5]\" data-kid=\"1-4-1-1-1-1-1-2\" data-name=\"logo front purple square outline\"></span>\n</span>\n<span class=\"text-[14.5px] font-semibold tracking-[-0.01em]\" data-kid=\"1-4-1-1-1-1-2\" data-name=\"brand name text\">FileFlow</span>\n</div>\n<p class=\"mt-3 text-[12.5px] leading-[1.7] text-[#71717A]\" data-kid=\"1-4-1-1-1-2\" data-name=\"footer brand tagline\">Your files, in the right format.</p>\n</div>\n<div class=\"flex gap-14\" data-kid=\"1-4-1-1-2\" data-name=\"footer links columns\">\n<div data-kid=\"1-4-1-1-2-1\" data-name=\"footer product link column\">\n<h3 class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#71717A]\" data-kid=\"1-4-1-1-2-1-1\" data-name=\"footer column heading (product)\">Product</h3>\n<ul class=\"mt-3 space-y-2 text-[12.5px]\" data-kid=\"1-4-1-1-2-1-2\" data-name=\"product links list\">\n<li data-kid=\"1-4-1-1-2-1-2-1\" data-name=\"product link item (convert a file)\"><a class=\"text-[#52525B] transition-colors hover:text-[#6D5EF5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-4-1-1-2-1-2-1-1\" data-name=\"convert a file link\" href=\"#convert\">Convert a file</a></li>\n<li data-kid=\"1-4-1-1-2-1-2-2\" data-name=\"product link item (popular conversions)\"><a class=\"text-[#52525B] transition-colors hover:text-[#6D5EF5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-4-1-1-2-1-2-2-1\" data-name=\"popular conversions link\" href=\"#converters\">Popular conversions</a></li>\n<li data-kid=\"1-4-1-1-2-1-2-3\" data-name=\"product link item (how it works)\"><a class=\"text-[#52525B] transition-colors hover:text-[#6D5EF5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-4-1-1-2-1-2-3-1\" data-name=\"how it works link\" href=\"#how-it-works\">How it works</a></li>\n</ul>\n</div>\n<div data-kid=\"1-4-1-1-2-2\" data-name=\"footer legal link column\">\n<h3 class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#71717A]\" data-kid=\"1-4-1-1-2-2-1\" data-name=\"footer column heading (legal)\">Legal</h3>\n<ul class=\"mt-3 space-y-2 text-[12.5px]\" data-kid=\"1-4-1-1-2-2-2\" data-name=\"legal links list\">\n<li data-kid=\"1-4-1-1-2-2-2-1\" data-name=\"legal link item (privacy)\"><a class=\"text-[#52525B] transition-colors hover:text-[#6D5EF5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-4-1-1-2-2-2-1-1\" data-name=\"privacy policy link\" href=\"/privacy\">Privacy policy</a></li>\n<li data-kid=\"1-4-1-1-2-2-2-2\" data-name=\"legal link item (terms)\"><a class=\"text-[#52525B] transition-colors hover:text-[#6D5EF5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-4-1-1-2-2-2-2-1\" data-name=\"terms of use link\" href=\"/terms\">Terms of use</a></li>\n<li data-kid=\"1-4-1-1-2-2-2-3\" data-name=\"legal link item (email)\"><a class=\"text-[#52525B] transition-colors hover:text-[#6D5EF5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-4-1-1-2-2-2-3-1\" data-name=\"contact email link\" href=\"mailto:hello@fileflow.app\">hello@fileflow.app</a></li>\n</ul>\n</div>\n</div>\n</div>\n<div class=\"mt-9 flex flex-wrap items-center justify-between gap-3 border-t border-[#E4E4E7] pt-4 text-[12px] text-[#71717A]\" data-kid=\"1-4-1-2\" data-name=\"footer bottom bar\">\n<span data-kid=\"1-4-1-2-1\" data-name=\"footer copyright text\">© 2026 FileFlow</span>\n<span class=\"inline-flex items-center gap-2 rounded-full border border-[#E4E4E7] bg-[#FAFAFA] px-2.5 py-1\" data-kid=\"1-4-1-2-2\" data-name=\"status pill (engine not connected)\">\n<span class=\"h-1.5 w-1.5 rounded-full bg-[#D4D4D8]\" data-kid=\"1-4-1-2-2-1\" data-name=\"offline status dot\"></span>\n          Conversion engine not connected\n        </span>\n</div>\n</div>\n</footer>\n</div>",
      "comments": [],
      "created": "2026-10-26T16:03:43.327738+00:00",
      "modified": "2026-10-26T16:28:07.569032+00:00",
      "id": "var_c71f4f5decb3",
      "contentHeight": 2235
    },
    "var_ad5eb6c33511": {
      "type": "variant",
      "label": "FileFlow — Upload states (component reference)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5520,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n</style>\n<div class=\"min-h-screen bg-[#FAFAFA] text-[#09090B] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: Inter, ui-sans-serif, system-ui, sans-serif;\">\n<div class=\"mx-auto max-w-[1184px] px-6 py-12\" data-kid=\"1-1\" data-name=\"page content container\">\n<header class=\"flex flex-wrap items-start justify-between gap-6 border-b border-[#E4E4E7] pb-6\" data-kid=\"1-1-1\" data-name=\"reference page header\">\n<div data-kid=\"1-1-1-1\" data-name=\"header title block\">\n<h1 class=\"text-[22px] font-semibold tracking-[-0.02em]\" data-kid=\"1-1-1-1-1\" data-name=\"page title heading\">FileUploadDropzone — state reference</h1>\n<p class=\"mt-1.5 max-w-[68ch] text-[13px] leading-[1.6] text-[#52525B]\" data-kid=\"1-1-1-1-2\" data-name=\"page description subtitle\">\n          One component, four states, plus the conversion notice. Validation reads from the shared format rules, so the error copy and the target options cannot drift apart.\n        </p>\n</div>\n<p class=\"rounded-md border border-[#E4E4E7] bg-white px-3 py-1.5 text-[11.5px] text-[#71717A]\" data-kid=\"1-1-1-2\" data-name=\"component width spec badge\">Component column width ≈ 280 px</p>\n</header>\n<!-- Four states side by side -->\n<div class=\"mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4\" data-kid=\"1-1-2\" data-name=\"four state grid container\">\n<!-- 1. Empty -->\n<section aria-labelledby=\"state-empty\" class=\"flex flex-col\" data-kid=\"1-1-2-1\" data-name=\"empty state card section\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-1-2-1-1\" data-name=\"state card title row\">\n<h2 class=\"text-[13px] font-semibold\" data-kid=\"1-1-2-1-1-1\" data-name=\"empty state heading\" id=\"state-empty\">Empty</h2>\n<span class=\"rounded-full border border-[#E4E4E7] bg-white px-2 py-0.5 text-[10.5px] uppercase tracking-[0.1em] text-[#71717A]\" data-kid=\"1-1-2-1-1-2\" data-name=\"empty state badge label\">default</span>\n</div>\n<p class=\"mt-1 text-[12px] leading-[1.5] text-[#71717A]\" data-kid=\"1-1-2-1-2\" data-name=\"empty state description text\">No file. Dropzone and picker both active.</p>\n<div class=\"mt-3 rounded-lg border border-[#E4E4E7] bg-white p-1.5 shadow-[0_1px_2px_rgba(9,9,11,0.03)]\" data-kid=\"1-1-2-1-3\" data-name=\"empty state dropzone card\">\n<div class=\"rounded-md border border-dashed border-[#D4D4D8] bg-[#FAFAFA] px-4 py-6 text-center\" data-kid=\"1-1-2-1-3-1\" data-name=\"dashed dropzone area\">\n<span class=\"inline-block text-[20px] text-[#52525B]\" data-kid=\"1-1-2-1-3-1-1\" data-name=\"upload cloud icon holder\"><i aria-hidden=\"true\" class=\"icon-upload-cloud\" data-kid=\"1-1-2-1-3-1-1-1\" data-name=\"upload cloud icon\"></i></span>\n<p class=\"mt-2.5 text-[13px] font-medium\" data-kid=\"1-1-2-1-3-1-2\" data-name=\"drop file primary text\">Drop a file here</p>\n<p class=\"mt-1 text-[11.5px] leading-[1.5] text-[#71717A]\" data-kid=\"1-1-2-1-3-1-3\" data-name=\"choose file secondary text\">or choose one from your device</p>\n<button class=\"mt-3.5 rounded-md border border-[#6D5EF5] bg-[#6D5EF5] px-3 py-1.5 text-[12px] font-medium text-white shadow-[0_8px_18px_-10px_rgba(109,94,245,0.85)] transition-colors hover:border-[#5B4CE0] hover:bg-[#5B4CE0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4B3DD4]\" data-kid=\"1-1-2-1-3-1-4\" data-name=\"choose file primary button\" type=\"button\">Choose file</button>\n</div>\n<div class=\"flex flex-wrap items-center justify-center gap-1 px-2 pb-1 pt-2.5\" data-kid=\"1-1-2-1-3-2\" data-name=\"supported formats tag row\">\n<span class=\"rounded-[2px] border border-blue-100 bg-blue-50 px-1 py-[2px] text-[9px] font-semibold tracking-[0.08em] text-blue-700\" data-kid=\"1-1-2-1-3-2-1\" data-name=\"DOCX format tag\">DOCX</span>\n<span class=\"rounded-[2px] border border-red-100 bg-red-50 px-1 py-[2px] text-[9px] font-semibold tracking-[0.08em] text-red-700\" data-kid=\"1-1-2-1-3-2-2\" data-name=\"PDF format tag\">PDF</span>\n<span class=\"rounded-[2px] border border-amber-100 bg-amber-50 px-1 py-[2px] text-[9px] font-semibold tracking-[0.08em] text-amber-700\" data-kid=\"1-1-2-1-3-2-3\" data-name=\"JPG format tag\">JPG</span>\n<span class=\"rounded-[2px] border border-teal-100 bg-teal-50 px-1 py-[2px] text-[9px] font-semibold tracking-[0.08em] text-teal-700\" data-kid=\"1-1-2-1-3-2-4\" data-name=\"PNG format tag\">PNG</span>\n<span class=\"rounded-[2px] border border-emerald-100 bg-emerald-50 px-1 py-[2px] text-[9px] font-semibold tracking-[0.08em] text-emerald-700\" data-kid=\"1-1-2-1-3-2-5\" data-name=\"XLSX format tag\">XLSX</span>\n<span class=\"rounded-[2px] border border-orange-100 bg-orange-50 px-1 py-[2px] text-[9px] font-semibold tracking-[0.08em] text-orange-700\" data-kid=\"1-1-2-1-3-2-6\" data-name=\"PPTX format tag\">PPTX</span>\n<span class=\"text-[9.5px] text-[#A1A1AA]\" data-kid=\"1-1-2-1-3-2-7\" data-name=\"max file size label\">25 MB</span>\n</div>\n</div>\n</section>\n<!-- 2. Dragging -->\n<section aria-labelledby=\"state-drag\" class=\"flex flex-col\" data-kid=\"1-1-2-2\" data-name=\"dragging state card section\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-1-2-2-1\" data-name=\"state card title row\">\n<h2 class=\"text-[13px] font-semibold\" data-kid=\"1-1-2-2-1-1\" data-name=\"dragging state heading\" id=\"state-drag\">Dragging</h2>\n<span class=\"rounded-full border border-[#6D5EF5] bg-[#6D5EF50F] px-2 py-0.5 text-[10.5px] uppercase tracking-[0.1em] text-[#4B3DD4]\" data-kid=\"1-1-2-2-1-2\" data-name=\"dragging state badge label\">dragenter</span>\n</div>\n<p class=\"mt-1 text-[12px] leading-[1.5] text-[#71717A]\" data-kid=\"1-1-2-2-2\" data-name=\"dragging state description text\">Border, fill and copy switch; the rest holds still.</p>\n<div class=\"mt-3 rounded-lg border border-[#E4E4E7] bg-white p-1.5 shadow-[0_1px_2px_rgba(9,9,11,0.03)]\" data-kid=\"1-1-2-2-3\" data-name=\"dragging state dropzone card\">\n<div class=\"rounded-md border border-[#6D5EF5] bg-[#6D5EF50D] px-4 py-6 text-center\" data-kid=\"1-1-2-2-3-1\" data-name=\"drag-active dropzone area\">\n<span class=\"inline-block text-[20px] text-[#6D5EF5]\" data-kid=\"1-1-2-2-3-1-1\" data-name=\"download icon holder\"><i aria-hidden=\"true\" class=\"icon-download\" data-kid=\"1-1-2-2-3-1-1-1\" data-name=\"download icon\"></i></span>\n<p class=\"mt-2.5 text-[13px] font-medium text-[#3F32C0]\" data-kid=\"1-1-2-2-3-1-2\" data-name=\"drop to select primary text\">Drop the file to select it</p>\n<p class=\"mt-1 text-[11.5px] leading-[1.5] text-[#5B4CE0]\" data-kid=\"1-1-2-2-3-1-3\" data-name=\"release to check secondary text\">Release to check the format</p>\n<button class=\"mt-3.5 rounded-md border border-[#E4E4E7] bg-white px-3 py-1.5 text-[12px] font-medium text-[#09090B] transition-colors hover:border-[#6D5EF5] hover:text-[#4B3DD4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-2-2-3-1-4\" data-name=\"choose file secondary button\" type=\"button\">Choose file</button>\n</div>\n<p class=\"px-2 pb-0.5 pt-2 text-[10.5px] leading-[1.5] text-[#71717A]\" data-kid=\"1-1-2-2-3-2\" data-name=\"drag depth implementation note\">Drag depth is counted so nested dragleave does not flicker.</p>\n</div>\n</section>\n<!-- 3. Selected + conversion options -->\n<section aria-labelledby=\"state-selected\" class=\"flex flex-col\" data-kid=\"1-1-2-3\" data-name=\"selected state card section\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-1-2-3-1\" data-name=\"state card title row\">\n<h2 class=\"text-[13px] font-semibold\" data-kid=\"1-1-2-3-1-1\" data-name=\"selected state heading\" id=\"state-selected\">Selected</h2>\n<span class=\"rounded-full border border-[#6D5EF5] bg-[#6D5EF50F] px-2 py-0.5 text-[10.5px] uppercase tracking-[0.1em] text-[#4B3DD4]\" data-kid=\"1-1-2-3-1-2\" data-name=\"valid state badge label\">valid</span>\n</div>\n<p class=\"mt-1 text-[12px] leading-[1.5] text-[#71717A]\" data-kid=\"1-1-2-3-2\" data-name=\"selected state description text\">File summary, then the target options appear.</p>\n<div class=\"mt-3 rounded-lg border border-[#E4E4E7] bg-white shadow-[0_1px_2px_rgba(9,9,11,0.03)]\" data-kid=\"1-1-2-3-3\" data-name=\"selected file card\">\n<div class=\"flex items-start gap-2.5 px-3.5 pb-3 pt-3.5\" data-kid=\"1-1-2-3-3-1\" data-name=\"selected file summary row\">\n<span class=\"mt-0.5 shrink-0\" data-kid=\"1-1-2-3-3-1-1\" data-name=\"file icon holder\">\n<span class=\"flex h-5 w-6 items-center justify-center rounded-[2px] border border-red-100 bg-red-50 text-[8px] font-bold tracking-[0.04em] text-red-700\" data-kid=\"1-1-2-3-3-1-1-1\" data-name=\"file type badge icon\">PDF</span>\n</span>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-3-3-1-2\" data-name=\"file details column\">\n<p class=\"truncate text-[12.5px] font-medium\" data-kid=\"1-1-2-3-3-1-2-1\" data-name=\"selected file name\">Q3-roadmap-review.pdf</p>\n<p class=\"mt-0.5 text-[11px] text-[#71717A]\" data-kid=\"1-1-2-3-3-1-2-2\" data-name=\"file size and type caption\">2.8 MB · PDF document</p>\n</div>\n<button aria-label=\"Remove file\" class=\"shrink-0 rounded-md p-1 text-[13px] text-[#71717A] transition-colors hover:bg-[#F4F4F5] hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-2-3-3-1-3\" data-name=\"remove file button\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon-x\" data-kid=\"1-1-2-3-3-1-3-1\" data-name=\"close x icon\"></i>\n</button>\n</div>\n<div class=\"border-t border-[#E4E4E7] px-3.5 py-3\" data-kid=\"1-1-2-3-3-2\" data-name=\"conversion options panel\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-1-2-3-3-2-1\" data-name=\"conversion header row\">\n<p class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#71717A]\" data-kid=\"1-1-2-3-3-2-1-1\" data-name=\"convert to label\">Convert to</p>\n<p class=\"text-[10.5px] text-[#A1A1AA]\" data-kid=\"1-1-2-3-3-2-1-2\" data-name=\"detected format label\">detected PDF</p>\n</div>\n<div class=\"mt-2 flex flex-wrap gap-1.5\" data-kid=\"1-1-2-3-3-2-2\" data-name=\"format selector button group\">\n<button aria-pressed=\"true\" class=\"rounded-full border border-[#6D5EF5] bg-[#6D5EF50F] px-2.5 py-1 text-[11.5px] font-medium text-[#4B3DD4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-2-3-3-2-2-1\" data-name=\"DOCX format toggle button\" type=\"button\">DOCX</button>\n<button aria-pressed=\"false\" class=\"rounded-full border border-[#E4E4E7] px-2.5 py-1 text-[11.5px] text-[#52525B] transition-colors hover:border-[#6D5EF5] hover:text-[#4B3DD4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-2-3-3-2-2-2\" data-name=\"JPG format toggle button\" type=\"button\">JPG</button>\n<button aria-pressed=\"false\" class=\"rounded-full border border-[#E4E4E7] px-2.5 py-1 text-[11.5px] text-[#52525B] transition-colors hover:border-[#6D5EF5] hover:text-[#4B3DD4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-2-3-3-2-2-3\" data-name=\"PNG format toggle button\" type=\"button\">PNG</button>\n</div>\n<button class=\"mt-3 w-full rounded-md border border-[#6D5EF5] bg-[#6D5EF5] px-3 py-2 text-[12.5px] font-medium text-white shadow-[0_10px_20px_-12px_rgba(109,94,245,0.9)] transition-colors hover:border-[#5B4CE0] hover:bg-[#5B4CE0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4B3DD4]\" data-kid=\"1-1-2-3-3-2-3\" data-name=\"convert file primary button\" type=\"button\">Convert file</button>\n</div>\n</div>\n</section>\n<!-- 4. Error -->\n<section aria-labelledby=\"state-error\" class=\"flex flex-col\" data-kid=\"1-1-2-4\" data-name=\"error state card section\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-1-2-4-1\" data-name=\"state card title row\">\n<h2 class=\"text-[13px] font-semibold\" data-kid=\"1-1-2-4-1-1\" data-name=\"error state heading\" id=\"state-error\">Error</h2>\n<span class=\"rounded-full border border-[#F3C6C6] bg-[#FDF2F2] px-2 py-0.5 text-[10.5px] uppercase tracking-[0.1em] text-[#B42318]\" data-kid=\"1-1-2-4-1-2\" data-name=\"rejected state badge label\">rejected</span>\n</div>\n<p class=\"mt-1 text-[12px] leading-[1.5] text-[#71717A]\" data-kid=\"1-1-2-4-2\" data-name=\"error state description text\">Unsupported extension or over the size cap.</p>\n<div class=\"mt-3 rounded-lg border border-[#E4E4E7] bg-white p-1.5 shadow-[0_1px_2px_rgba(9,9,11,0.03)]\" data-kid=\"1-1-2-4-3\" data-name=\"error state dropzone card\">\n<div class=\"rounded-md border border-dashed border-[#E9A8A8] bg-[#FEF6F6] px-4 py-4 text-center\" data-kid=\"1-1-2-4-3-1\" data-name=\"error dropzone area\">\n<span class=\"inline-block text-[20px] text-[#B42318]\" data-kid=\"1-1-2-4-3-1-1\" data-name=\"alert icon holder\"><i aria-hidden=\"true\" class=\"icon-alert-circle\" data-kid=\"1-1-2-4-3-1-1-1\" data-name=\"alert circle icon\"></i></span>\n<p class=\"mt-2 text-[12.5px] font-medium text-[#8A1C13]\" data-kid=\"1-1-2-4-3-1-2\" data-name=\"error message title\">That file can't be converted</p>\n<p class=\"mx-auto mt-1 max-w-[26ch] text-[11.5px] leading-[1.55] text-[#8A3B34]\" data-kid=\"1-1-2-4-3-1-3\" data-name=\"error explanation text\">\n              brand-guide.ai is not a supported format. Use DOCX, PDF, JPG, JPEG, PNG, XLSX or PPTX.\n            </p>\n<div class=\"mt-3 flex items-center justify-center gap-2\" data-kid=\"1-1-2-4-3-1-4\" data-name=\"error action button row\">\n<button class=\"rounded-md bg-[#09090B] px-3 py-1.5 text-[12px] font-medium text-white transition-colors hover:bg-[#27272A] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-2-4-3-1-4-1\" data-name=\"try another file button\" type=\"button\">Try another file</button>\n<button class=\"rounded-md px-2 py-1.5 text-[11.5px] text-[#71717A] underline underline-offset-2 transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-2-4-3-1-4-2\" data-name=\"dismiss error button\" type=\"button\">Dismiss</button>\n</div>\n</div>\n<p class=\"px-2 pb-0.5 pt-2 text-[10.5px] leading-[1.5] text-[#71717A]\" data-kid=\"1-1-2-4-3-2\" data-name=\"error implementation note\">file.type is empty for .ai — check the extension first, then the size.</p>\n</div>\n</section>\n</div>\n<!-- Conversion notice -->\n<section aria-labelledby=\"state-notice\" class=\"mt-10\" data-kid=\"1-1-3\" data-name=\"conversion notice section\">\n<div class=\"flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-1-3-1\" data-name=\"notice section header row\">\n<h2 class=\"text-[13px] font-semibold\" data-kid=\"1-1-3-1-1\" data-name=\"notice section heading\" id=\"state-notice\">After Convert — engine not connected</h2>\n<span class=\"text-[11.5px] text-[#71717A]\" data-kid=\"1-1-3-1-2\" data-name=\"notice section caption\">Inline notice and toast share the same copy</span>\n</div>\n<div class=\"mt-3 grid grid-cols-1 gap-5 lg:grid-cols-[1.15fr_1fr]\" data-kid=\"1-1-3-2\" data-name=\"notice two card grid\">\n<div class=\"rounded-lg border border-[#E4E4E7] bg-white p-3.5\" data-kid=\"1-1-3-2-1\" data-name=\"inline notice card\">\n<div class=\"flex items-start gap-2.5\" data-kid=\"1-1-3-2-1-1\" data-name=\"notice message row\">\n<span class=\"mt-0.5 shrink-0 text-[16px] text-[#6D5EF5]\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"plug icon holder\"><i aria-hidden=\"true\" class=\"icon-plug-zap\" data-kid=\"1-1-3-2-1-1-1-1\" data-name=\"plug zigzag icon\"></i></span>\n<div data-kid=\"1-1-3-2-1-1-2\" data-name=\"notice message text block\">\n<p class=\"text-[12.5px] font-medium\" data-kid=\"1-1-3-2-1-1-2-1\" data-name=\"notice title text\">Conversion engine not connected</p>\n<p class=\"mt-1 text-[11.5px] leading-[1.6] text-[#52525B]\" data-kid=\"1-1-3-2-1-1-2-2\" data-name=\"notice body text\">\n                This UI is ready for API integration. Nothing was uploaded and no download was produced.\n              </p>\n</div>\n</div>\n<div class=\"mt-3 flex items-center gap-2 border-t border-[#E4E4E7] pt-3\" data-kid=\"1-1-3-2-1-2\" data-name=\"endpoint action row\">\n<code class=\"flex-1 truncate rounded-sm bg-[#6D5EF50A] px-2 py-1 text-[11px] text-[#4B3DD4]\" data-kid=\"1-1-3-2-1-2-1\" data-name=\"API endpoint code block\">POST /api/convert</code>\n<button class=\"rounded-md border border-[#E4E4E7] px-2.5 py-1 text-[11.5px] font-medium transition-colors hover:border-[#6D5EF5] hover:text-[#4B3DD4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-3-2-1-2-2\" data-name=\"copy endpoint button\" type=\"button\">Copy endpoint</button>\n</div>\n</div>\n<div class=\"rounded-lg border border-[#E4E4E7] bg-white p-3.5\" data-kid=\"1-1-3-2-2\" data-name=\"toast card\">\n<p class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#71717A]\" data-kid=\"1-1-3-2-2-1\" data-name=\"toast label heading\">Toast</p>\n<div class=\"mt-2.5 flex items-start gap-2.5 rounded-md border border-[#E4E4E7] bg-white px-3 py-2.5 shadow-[0_8px_24px_-16px_rgba(9,9,11,0.35)]\" data-kid=\"1-1-3-2-2-2\" data-name=\"toast notification bar\">\n<span class=\"mt-0.5 shrink-0 text-[14px] text-[#6D5EF5]\" data-kid=\"1-1-3-2-2-2-1\" data-name=\"info icon holder\"><i aria-hidden=\"true\" class=\"icon-info\" data-kid=\"1-1-3-2-2-2-1-1\" data-name=\"info icon\"></i></span>\n<p class=\"flex-1 text-[11.5px] leading-[1.6] text-[#52525B]\" data-kid=\"1-1-3-2-2-2-2\" data-name=\"toast message text\">\n<span class=\"font-medium text-[#09090B]\" data-kid=\"1-1-3-2-2-2-2-1\" data-name=\"toast message strong text\">Conversion engine not connected.</span>\n              This UI is ready for API integration.\n            </p>\n<button aria-label=\"Dismiss notice\" class=\"shrink-0 rounded-sm p-0.5 text-[12px] text-[#A1A1AA] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-3-2-2-2-3\" data-name=\"dismiss toast button\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon-x\" data-kid=\"1-1-3-2-2-2-3-1\" data-name=\"toast close x icon\"></i>\n</button>\n</div>\n<p class=\"mt-2.5 text-[11px] leading-[1.55] text-[#71717A]\" data-kid=\"1-1-3-2-2-3\" data-name=\"toast accessibility note\">role=\"status\" aria-live=\"polite\", dismissible, cleared on the next file selection.</p>\n</div>\n</div>\n</section>\n<!-- Behaviour notes -->\n<section class=\"mt-10 grid grid-cols-1 gap-5 border-t border-[#E4E4E7] pt-6 sm:grid-cols-3\" data-kid=\"1-1-4\" data-name=\"behaviour notes grid section\">\n<div data-kid=\"1-1-4-1\" data-name=\"keyboard pointer note block\">\n<h3 class=\"text-[12px] font-semibold\" data-kid=\"1-1-4-1-1\" data-name=\"keyboard and pointer note title\">Keyboard and pointer</h3>\n<p class=\"mt-1.5 text-[11.5px] leading-[1.65] text-[#52525B]\" data-kid=\"1-1-4-1-2\" data-name=\"keyboard and pointer note body\">The dropzone is a focusable group with the picker as its only tab stop; Enter or Space opens the picker. Drag events reset on dragleave and drop.</p>\n</div>\n<div data-kid=\"1-1-4-2\" data-name=\"validation order note block\">\n<h3 class=\"text-[12px] font-semibold\" data-kid=\"1-1-4-2-1\" data-name=\"validation order note title\">Validation order</h3>\n<p class=\"mt-1.5 text-[11.5px] leading-[1.65] text-[#52525B]\" data-kid=\"1-1-4-2-2\" data-name=\"validation order note body\">Extension first, then the 25 MB cap, then the empty-file check. Each failure sets its own message rather than one generic error.</p>\n</div>\n<div data-kid=\"1-1-4-3\" data-name=\"single source of truth note block\">\n<h3 class=\"text-[12px] font-semibold\" data-kid=\"1-1-4-3-1\" data-name=\"single source of truth note title\">Single source of truth</h3>\n<p class=\"mt-1.5 text-[11.5px] leading-[1.65] text-[#52525B]\" data-kid=\"1-1-4-3-2\" data-name=\"single source of truth note body\">formats.ts exports the extension list, the size cap, the target map, the colour map and the byte formatter — every state above reads from it.</p>\n</div>\n</section>\n</div>\n</div>",
      "comments": [],
      "created": "2026-10-26T16:04:10.545973+00:00",
