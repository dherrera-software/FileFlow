    "var_238dc053b62e": {
      "type": "variant",
      "label": "FileFlow — Proof Sheet (empty state)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n</style>\n<div class=\"min-h-screen bg-white text-[#09090B] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: Inter, ui-sans-serif, system-ui, sans-serif;\">\n<!-- Navbar: hairline, sharp -->\n<header class=\"border-b border-[#09090B26]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[64px] max-w-[1128px] items-stretch px-6\" data-kid=\"1-1-1\" data-name=\"header inner layout container\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#top\">\n<span aria-hidden=\"true\" class=\"relative block h-[20px] w-[20px]\" data-kid=\"1-1-1-1-1\" data-name=\"file icon mark container\">\n<span class=\"absolute left-0 top-[3px] block h-[14px] w-[11px] border border-[#09090B66]\" data-kid=\"1-1-1-1-1-1\" data-name=\"file icon back document outline\"></span>\n<span class=\"absolute left-[8px] top-0 block h-[14px] w-[11px] border-[1.5px] border-[#6D5EF5]\" data-kid=\"1-1-1-1-1-2\" data-name=\"file icon front document outline\"></span>\n</span>\n<span class=\"text-[14px] font-semibold tracking-[0.01em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">FileFlow</span>\n</a>\n<nav aria-label=\"Main\" class=\"ml-10 hidden items-stretch gap-8 md:flex\" data-kid=\"1-1-1-2\" data-name=\"primary navigation links\">\n<a aria-current=\"page\" class=\"flex items-center border-b-2 border-[#6D5EF5] text-[13px] font-medium focus-visible:outline-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-1-2-1\" data-name=\"nav link for current page (Home)\" href=\"#top\">Home</a>\n<a class=\"flex items-center border-b-2 border-transparent text-[13px] text-[#71717A] transition-colors hover:border-[#09090B26] hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-1-2-2\" data-name=\"nav link to converters\" href=\"#converters\">Converters</a>\n<a class=\"flex items-center border-b-2 border-transparent text-[13px] text-[#71717A] transition-colors hover:border-[#09090B26] hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-1-2-3\" data-name=\"nav link to how it works\" href=\"#how-it-works\">How it works</a>\n</nav>\n<div class=\"ml-auto flex items-center gap-5\" data-kid=\"1-1-1-3\" data-name=\"header right actions cluster\">\n<span class=\"hidden text-[12px] uppercase tracking-[0.14em] text-[#71717A] sm:block\" data-kid=\"1-1-1-3-1\" data-name=\"formats count badge label\">Seven formats</span>\n<a class=\"border border-[#09090B] px-3.5 py-2 text-[12.5px] font-medium transition-colors hover:bg-[#09090B] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-1-3-2\" data-name=\"primary call-to-action button\" href=\"#convert\">Start converting</a>\n</div>\n</div>\n</header>\n<main data-kid=\"1-2\" data-name=\"main content region\" id=\"top\">\n<!-- Hero: proof sheet -->\n<section class=\"relative border-b border-[#09090B26]\" data-kid=\"1-2-1\" data-name=\"hero section\">\n<div class=\"relative mx-auto max-w-[1128px] px-6 pb-16 pt-14\" data-kid=\"1-2-1-1\" data-name=\"hero inner container\">\n<div class=\"mx-auto max-w-[820px] text-center\" data-kid=\"1-2-1-1-1\" data-name=\"hero text block\">\n<p class=\"inline-block border border-[#09090B33] px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.22em] text-[#52525B]\" data-dynamic=\"true\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero category badge\" data-reason=\"text replaced by rotating format label script\">Simple file conversion</p>\n<h1 class=\"mx-auto mt-7 max-w-[20ch] text-[46px] font-normal leading-[1.02] tracking-[-0.045em] sm:text-[66px]\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero headline\">\n            Your files, in the right format.\n          </h1>\n<p class=\"mx-auto mt-6 max-w-[58ch] text-[15.5px] leading-[1.65] text-[#52525B]\" data-kid=\"1-2-1-1-1-3\" data-name=\"hero description paragraph\">\n            One file in, one file out. FileFlow reads the extension, shows the conversions that exist for it, and refuses everything else before it reaches the engine.\n          </p>\n</div>\n<!-- Double keyline frame with registration ticks -->\n<div class=\"relative mx-auto mt-12 max-w-[720px]\" data-kid=\"1-2-1-1-2\" data-name=\"hero proof sheet frame wrapper\">\n<div class=\"pointer-events-none absolute -inset-x-24 -top-10 bottom-6 bg-[radial-gradient(46%_56%_at_50%_45%,rgba(109,94,245,0.10),rgba(109,94,245,0.02)_60%,transparent_78%)]\" data-kid=\"1-2-1-1-2-1\" data-name=\"decorative glow gradient\"></div>\n<div class=\"relative\" data-kid=\"1-2-1-1-2-2\" data-name=\"registration tick corner frame\">\n<span aria-hidden=\"true\" class=\"absolute -left-[5px] -top-[5px] block h-[10px] w-[10px] border-l border-t border-[#09090B]\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"registration tick top-left\"></span>\n<span aria-hidden=\"true\" class=\"absolute -right-[5px] -top-[5px] block h-[10px] w-[10px] border-r border-t border-[#09090B]\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"registration tick top-right\"></span>\n<span aria-hidden=\"true\" class=\"absolute -bottom-[5px] -left-[5px] block h-[10px] w-[10px] border-b border-l border-[#09090B]\" data-kid=\"1-2-1-1-2-2-3\" data-name=\"registration tick bottom-left\"></span>\n<span aria-hidden=\"true\" class=\"absolute -bottom-[5px] -right-[5px] block h-[10px] w-[10px] border-b border-r border-[#09090B]\" data-kid=\"1-2-1-1-2-2-4\" data-name=\"registration tick bottom-right\"></span>\n<div class=\"border border-[#09090B99] bg-white p-[5px]\" data-kid=\"1-2-1-1-2-2-5\" data-name=\"proof sheet outer frame\">\n<section aria-labelledby=\"proof-upload-label\" class=\"border border-[#09090B26] px-8 py-11\" data-kid=\"1-2-1-1-2-2-5-1\" data-name=\"upload sheet card\" id=\"convert\">\n<h2 class=\"sr-only\" data-kid=\"1-2-1-1-2-2-5-1-1\" data-name=\"visually hidden upload sheet heading\" id=\"proof-upload-label\">Upload a file to convert</h2>\n<div class=\"flex flex-col items-center text-center\" data-kid=\"1-2-1-1-2-2-5-1-2\" data-name=\"upload sheet content\">\n<span class=\"inline-block text-[26px] font-light leading-none text-[#09090B]\" data-kid=\"1-2-1-1-2-2-5-1-2-1\" data-name=\"upload add-plus icon\"><i aria-hidden=\"true\" class=\"icon-plus\" data-kid=\"1-2-1-1-2-2-5-1-2-1-1\"></i></span>\n<p class=\"mt-4 text-[16px] font-medium tracking-[-0.01em]\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-2-5-1-2-2\" data-name=\"drop zone status text\" data-reason=\"text replaced with selected filename on file selection\">Nothing selected</p>\n<p class=\"mt-2 max-w-[42ch] text-[13px] leading-[1.65] text-[#71717A]\" data-kid=\"1-2-1-1-2-2-5-1-2-3\" data-name=\"drop zone description text\">\n                    Drag a file onto this sheet, or choose one from your device. It stays in the browser until you convert.\n                  </p>\n<div class=\"mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-3\" data-kid=\"1-2-1-1-2-2-5-1-2-4\" data-name=\"upload sheet action row\">\n<button class=\"border border-[#09090B] px-4 py-2.5 text-[12.5px] font-medium transition-colors hover:bg-[#09090B] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-1-1-2-2-5-1-2-4-1\" data-name=\"choose file button\" type=\"button\">\n                      Choose file\n                    </button>\n<span class=\"text-[11.5px] uppercase tracking-[0.13em] text-[#71717A]\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-2-5-1-2-4-2\" data-name=\"supported formats label\" data-reason=\"text replaces static list with available conversion options after selection\">DOCX, PDF, JPG, JPEG, PNG, XLSX, PPTX</span>\n</div>\n</div>\n<div class=\"mt-9 flex items-center gap-4 border-t border-[#09090B1A] pt-4 text-[11px] uppercase tracking-[0.12em] text-[#71717A]\" data-kid=\"1-2-1-1-2-2-5-1-3\" data-name=\"upload sheet footer meta row\">\n<span data-kid=\"1-2-1-1-2-2-5-1-3-1\" data-name=\"meta size limit note\">Max 25 MB</span>\n<span class=\"h-3 w-px bg-[#09090B26]\" data-kid=\"1-2-1-1-2-2-5-1-3-2\" data-name=\"meta separator divider\"></span>\n<span data-kid=\"1-2-1-1-2-2-5-1-3-3\" data-name=\"meta no-account note\">No account</span>\n<span class=\"h-3 w-px bg-[#09090B26]\" data-kid=\"1-2-1-1-2-2-5-1-3-4\" data-name=\"meta separator divider\"></span>\n<span class=\"text-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-2-5-1-3-5\" data-name=\"meta target format note\" data-reason=\"text replaced with chosen target format after file selection\">Target format appears after selection</span>\n</div>\n</section>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Popular conversions: ruled agenda list -->\n<section class=\"border-b border-[#09090B26]\" data-kid=\"1-2-2\" data-name=\"popular conversions section\" id=\"converters\">\n<div class=\"mx-auto max-w-[1128px] px-6 py-14\" data-kid=\"1-2-2-1\" data-name=\"conversions inner container\">\n<div class=\"flex flex-wrap items-baseline justify-between gap-3\" data-kid=\"1-2-2-1-1\" data-name=\"conversions header row\">\n<h2 class=\"text-[22px] font-normal tracking-[-0.02em]\" data-kid=\"1-2-2-1-1-1\" data-name=\"conversions section title\">Popular conversions</h2>\n<p class=\"text-[12px] uppercase tracking-[0.14em] text-[#71717A]\" data-kid=\"1-2-2-1-1-2\" data-name=\"conversions section subtitle\">Each row is a rule in the converter</p>\n</div>\n<ul class=\"mt-8 border-t border-[#09090B26]\" data-kid=\"1-2-2-1-2\" data-name=\"conversions list\">\n<li data-kid=\"1-2-2-1-2-1\" data-name=\"conversion row DOCX to PDF\">\n<a class=\"group flex items-center gap-6 border-b border-[#09090B1A] px-2 py-4 transition-colors hover:bg-[#09090B0A] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"conversion row link\" href=\"#convert\">\n<span class=\"w-[70px] text-[13px] font-medium tracking-[0.1em]\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"source format label\">DOCX</span>\n<span class=\"hidden w-[120px] text-[11.5px] text-[#A1A1AA] sm:block\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"source format description\">Word document</span>\n<span aria-hidden=\"true\" class=\"h-px flex-1 bg-[#09090B26] transition-colors group-hover:bg-[#6D5EF580]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1-1-3\" data-name=\"conversion connector line\" data-reason=\"width color driven by group hover state\"></span>\n<span class=\"w-[70px] text-right text-[13px] font-medium tracking-[0.1em] group-hover:text-[#4B3DD4]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1-1-4\" data-name=\"target format label\" data-reason=\"text color driven by group hover state\">PDF</span>\n<span aria-hidden=\"true\" class=\"w-4 text-[12px] text-transparent transition-colors group-hover:text-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1-1-5\" data-name=\"conversion arrow icon container\" data-reason=\"color driven by group hover state\"><i class=\"icon-arrow-right\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1-1-5-1\" data-name=\"arrow right icon\" data-reason=\"color driven by group hover state\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-2\" data-name=\"conversion row PDF to DOCX\">\n<a class=\"group flex items-center gap-6 border-b border-[#09090B1A] px-2 py-4 transition-colors hover:bg-[#09090B0A] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"conversion row link\" href=\"#convert\">\n<span class=\"w-[70px] text-[13px] font-medium tracking-[0.1em]\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"source format label\">PDF</span>\n<span class=\"hidden w-[120px] text-[11.5px] text-[#A1A1AA] sm:block\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"source format description\">Portable document</span>\n<span aria-hidden=\"true\" class=\"h-px flex-1 bg-[#09090B26] transition-colors group-hover:bg-[#6D5EF580]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-1-3\" data-name=\"conversion connector line\" data-reason=\"width color driven by group hover state\"></span>\n<span class=\"w-[70px] text-right text-[13px] font-medium tracking-[0.1em] group-hover:text-[#4B3DD4]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-1-4\" data-name=\"target format label\" data-reason=\"text color driven by group hover state\">DOCX</span>\n<span aria-hidden=\"true\" class=\"w-4 text-[12px] text-transparent transition-colors group-hover:text-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-1-5\" data-name=\"conversion arrow icon container\" data-reason=\"color driven by group hover state\"><i class=\"icon-arrow-right\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-1-5-1\" data-name=\"arrow right icon\" data-reason=\"color driven by group hover state\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-3\" data-name=\"conversion row JPG to PDF\">\n<a class=\"group flex items-center gap-6 border-b border-[#09090B1A] px-2 py-4 transition-colors hover:bg-[#09090B0A] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"conversion row link\" href=\"#convert\">\n<span class=\"w-[70px] text-[13px] font-medium tracking-[0.1em]\" data-kid=\"1-2-2-1-2-3-1-1\" data-name=\"source format label\">JPG</span>\n<span class=\"hidden w-[120px] text-[11.5px] text-[#A1A1AA] sm:block\" data-kid=\"1-2-2-1-2-3-1-2\" data-name=\"source format description\">Photo</span>\n<span aria-hidden=\"true\" class=\"h-px flex-1 bg-[#09090B26] transition-colors group-hover:bg-[#6D5EF580]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-3-1-3\" data-name=\"conversion connector line\" data-reason=\"width color driven by group hover state\"></span>\n<span class=\"w-[70px] text-right text-[13px] font-medium tracking-[0.1em] group-hover:text-[#4B3DD4]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-3-1-4\" data-name=\"target format label\" data-reason=\"text color driven by group hover state\">PDF</span>\n<span aria-hidden=\"true\" class=\"w-4 text-[12px] text-transparent transition-colors group-hover:text-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-3-1-5\" data-name=\"conversion arrow icon container\" data-reason=\"color driven by group hover state\"><i class=\"icon-arrow-right\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-3-1-5-1\" data-name=\"arrow right icon\" data-reason=\"color driven by group hover state\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-4\" data-name=\"conversion row PDF to JPG\">\n<a class=\"group flex items-center gap-6 border-b border-[#09090B1A] px-2 py-4 transition-colors hover:bg-[#09090B0A] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"conversion row link\" href=\"#convert\">\n<span class=\"w-[70px] text-[13px] font-medium tracking-[0.1em]\" data-kid=\"1-2-2-1-2-4-1-1\" data-name=\"source format label\">PDF</span>\n<span class=\"hidden w-[120px] text-[11.5px] text-[#A1A1AA] sm:block\" data-kid=\"1-2-2-1-2-4-1-2\" data-name=\"source format description\">Portable document</span>\n<span aria-hidden=\"true\" class=\"h-px flex-1 bg-[#09090B26] transition-colors group-hover:bg-[#6D5EF580]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-4-1-3\" data-name=\"conversion connector line\" data-reason=\"width color driven by group hover state\"></span>\n<span class=\"w-[70px] text-right text-[13px] font-medium tracking-[0.1em] group-hover:text-[#4B3DD4]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-4-1-4\" data-name=\"target format label\" data-reason=\"text color driven by group hover state\">JPG</span>\n<span aria-hidden=\"true\" class=\"w-4 text-[12px] text-transparent transition-colors group-hover:text-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-4-1-5\" data-name=\"conversion arrow icon container\" data-reason=\"color driven by group hover state\"><i class=\"icon-arrow-right\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-4-1-5-1\" data-name=\"arrow right icon\" data-reason=\"color driven by group hover state\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-5\" data-name=\"conversion row XLSX to PDF\">\n<a class=\"group flex items-center gap-6 border-b border-[#09090B1A] px-2 py-4 transition-colors hover:bg-[#09090B0A] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-2-5-1\" data-name=\"conversion row link\" href=\"#convert\">\n<span class=\"w-[70px] text-[13px] font-medium tracking-[0.1em]\" data-kid=\"1-2-2-1-2-5-1-1\" data-name=\"source format label\">XLSX</span>\n<span class=\"hidden w-[120px] text-[11.5px] text-[#A1A1AA] sm:block\" data-kid=\"1-2-2-1-2-5-1-2\" data-name=\"source format description\">Spreadsheet</span>\n<span aria-hidden=\"true\" class=\"h-px flex-1 bg-[#09090B26] transition-colors group-hover:bg-[#6D5EF580]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-5-1-3\" data-name=\"conversion connector line\" data-reason=\"width color driven by group hover state\"></span>\n<span class=\"w-[70px] text-right text-[13px] font-medium tracking-[0.1em] group-hover:text-[#4B3DD4]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-5-1-4\" data-name=\"target format label\" data-reason=\"text color driven by group hover state\">PDF</span>\n<span aria-hidden=\"true\" class=\"w-4 text-[12px] text-transparent transition-colors group-hover:text-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-5-1-5\" data-name=\"conversion arrow icon container\" data-reason=\"color driven by group hover state\"><i class=\"icon-arrow-right\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-5-1-5-1\" data-name=\"arrow right icon\" data-reason=\"color driven by group hover state\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-6\" data-name=\"conversion row PPTX to PDF\">\n<a class=\"group flex items-center gap-6 border-b border-[#09090B26] px-2 py-4 transition-colors hover:bg-[#09090B0A] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-2-6-1\" data-name=\"conversion row link\" href=\"#convert\">\n<span class=\"w-[70px] text-[13px] font-medium tracking-[0.1em]\" data-kid=\"1-2-2-1-2-6-1-1\" data-name=\"source format label\">PPTX</span>\n<span class=\"hidden w-[120px] text-[11.5px] text-[#A1A1AA] sm:block\" data-kid=\"1-2-2-1-2-6-1-2\" data-name=\"source format description\">Slide deck</span>\n<span aria-hidden=\"true\" class=\"h-px flex-1 bg-[#09090B26] transition-colors group-hover:bg-[#6D5EF580]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-6-1-3\" data-name=\"conversion connector line\" data-reason=\"width color driven by group hover state\"></span>\n<span class=\"w-[70px] text-right text-[13px] font-medium tracking-[0.1em] group-hover:text-[#4B3DD4]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-6-1-4\" data-name=\"target format label\" data-reason=\"text color driven by group hover state\">PDF</span>\n<span aria-hidden=\"true\" class=\"w-4 text-[12px] text-transparent transition-colors group-hover:text-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-6-1-5\" data-name=\"conversion arrow icon container\" data-reason=\"color driven by group hover state\"><i class=\"icon-arrow-right\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-6-1-5-1\" data-name=\"arrow right icon\" data-reason=\"color driven by group hover state\"></i></span>\n</a>\n</li>\n</ul>\n<p class=\"mt-4 text-[12px] text-[#71717A]\" data-kid=\"1-2-2-1-3\" data-name=\"conversions help note\">Selecting a row sets that target format in the upload sheet above.</p>\n</div>\n</section>\n<!-- How it works: oversized numerals -->\n<section class=\"border-b border-[#09090B26]\" data-kid=\"1-2-3\" data-name=\"how it works section\" id=\"how-it-works\">\n<div class=\"mx-auto max-w-[1128px] px-6 py-14\" data-kid=\"1-2-3-1\" data-name=\"how it works inner container\">\n<div class=\"flex flex-wrap items-baseline justify-between gap-3\" data-kid=\"1-2-3-1-1\" data-name=\"how it works header row\">\n<h2 class=\"text-[22px] font-normal tracking-[-0.02em]\" data-kid=\"1-2-3-1-1-1\" data-name=\"how it works section title\">How it works</h2>\n<p class=\"text-[12px] uppercase tracking-[0.14em] text-[#71717A]\" data-kid=\"1-2-3-1-1-2\" data-name=\"how it works section subtitle\">Three moves, no wizard</p>\n</div>\n<div class=\"mt-10 grid grid-cols-1 gap-12 md:grid-cols-3 md:gap-10\" data-kid=\"1-2-3-1-2\" data-name=\"steps grid\">\n<div data-kid=\"1-2-3-1-2-1\" data-name=\"step one card\">\n<span class=\"block text-[68px] font-extralight leading-[0.8] tracking-[-0.05em] text-[#09090B4D]\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"step one numeral\">01</span>\n<h3 class=\"-mt-2 text-[16px] font-medium tracking-[-0.01em]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"step one title\">Select a file</h3>\n<p class=\"mt-2.5 max-w-[32ch] text-[13px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"step one description\">\n              Drop it on the sheet or use the picker. One file, up to 25 MB, from the seven supported formats.\n            </p>\n</div>\n<div data-kid=\"1-2-3-1-2-2\" data-name=\"step two card\">\n<span class=\"block text-[68px] font-extralight leading-[0.8] tracking-[-0.05em] text-[#09090B4D]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"step two numeral\">02</span>\n<h3 class=\"-mt-2 text-[16px] font-medium tracking-[-0.01em]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"step two title\">Choose the target</h3>\n<p class=\"mt-2.5 max-w-[32ch] text-[13px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"step two description\">\n              The extension is read on selection. Only targets that exist for that source are offered — nothing aspirational.\n            </p>\n</div>\n<div data-kid=\"1-2-3-1-2-3\" data-name=\"step three card\">\n<span class=\"block text-[68px] font-extralight leading-[0.8] tracking-[-0.05em] text-[#09090B4D]\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"step three numeral\">03</span>\n<h3 class=\"-mt-2 text-[16px] font-medium tracking-[-0.01em]\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"step three title\">Convert</h3>\n<p class=\"mt-2.5 max-w-[32ch] text-[13px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"step three description\">\n              The engine is not connected, so the action reports that in one line. No progress bar, no placeholder download.\n            </p>\n</div>\n</div>\n</div>\n</section>\n<!-- Formats ticker tape -->\n<section class=\"overflow-hidden border-b border-[#09090B26] bg-white\" data-kid=\"1-2-4\" data-name=\"formats ticker section\">\n<div class=\"flex items-center gap-0 whitespace-nowrap py-3.5\" data-kid=\"1-2-4-1\" data-name=\"ticker track\">\n<span class=\"shrink-0 border-r border-[#09090B26] px-5 text-[10.5px] font-medium uppercase tracking-[0.2em] text-[#6D5EF5]\" data-kid=\"1-2-4-1-1\" data-name=\"ticker supported label\">Supported</span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#52525B]\" data-kid=\"1-2-4-1-2\" data-name=\"format ticker item DOCX\">DOCX</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-3\" data-name=\"ticker divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#52525B]\" data-kid=\"1-2-4-1-4\" data-name=\"format ticker item PDF\">PDF</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-5\" data-name=\"ticker divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#52525B]\" data-kid=\"1-2-4-1-6\" data-name=\"format ticker item JPG\">JPG</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-7\" data-name=\"ticker divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#52525B]\" data-kid=\"1-2-4-1-8\" data-name=\"format ticker item JPEG\">JPEG</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-9\" data-name=\"ticker divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#52525B]\" data-kid=\"1-2-4-1-10\" data-name=\"format ticker item PNG\">PNG</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-11\" data-name=\"ticker divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#52525B]\" data-kid=\"1-2-4-1-12\" data-name=\"format ticker item XLSX\">XLSX</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-13\" data-name=\"ticker divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#52525B]\" data-kid=\"1-2-4-1-14\" data-name=\"format ticker item PPTX\">PPTX</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-15\" data-name=\"ticker divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#09090B]\" data-kid=\"1-2-4-1-16\" data-name=\"ticker size note\">25 MB max</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-17\" data-name=\"ticker divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#09090B]\" data-kid=\"1-2-4-1-18\" data-name=\"ticker privacy note\">No files stored</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-19\" data-name=\"ticker divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#52525B]\" data-kid=\"1-2-4-1-20\" data-name=\"format ticker item DOCX repeat\">DOCX</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-21\" data-name=\"ticker divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#52525B]\" data-kid=\"1-2-4-1-22\" data-name=\"format ticker item PDF repeat\">PDF</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-23\" data-name=\"ticker divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#52525B]\" data-kid=\"1-2-4-1-24\" data-name=\"format ticker item JPG repeat\">JPG</span>\n</div>\n</section>\n<!-- Privacy + FAQ -->\n<section class=\"border-b border-[#09090B26]\" data-kid=\"1-2-5\" data-name=\"privacy and FAQ section\" id=\"privacy\">\n<div class=\"mx-auto max-w-[1128px] px-6 py-14\" data-kid=\"1-2-5-1\" data-name=\"privacy and FAQ inner container\">\n<div class=\"grid grid-cols-1 gap-12 md:grid-cols-[1fr_1.1fr] md:gap-16\" data-kid=\"1-2-5-1-1\" data-name=\"privacy and FAQ grid\">\n<div class=\"border-t border-[#09090B26] pt-6\" data-kid=\"1-2-5-1-1-1\" data-name=\"privacy column\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-2-5-1-1-1-1\" data-name=\"privacy column header\">\n<span class=\"text-[17px] text-[#6D5EF5]\" data-kid=\"1-2-5-1-1-1-1-1\" data-name=\"shield check icon container\"><i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-5-1-1-1-1-1-1\" data-name=\"shield check icon\"></i></span>\n<h2 class=\"text-[17px] font-medium tracking-[-0.01em]\" data-kid=\"1-2-5-1-1-1-1-2\" data-name=\"privacy column heading\">Privacy, stated plainly</h2>\n</div>\n<p class=\"mt-3 max-w-[46ch] text-[13px] leading-[1.75] text-[#52525B]\" data-kid=\"1-2-5-1-1-1-2\" data-name=\"privacy description text\">\n              File selection and format checks run in the browser. Nothing is sent to a server, queued, or retained, because there is no conversion service connected yet. When there is, your file travels only for the duration of the job.\n            </p>\n<p class=\"mt-4 text-[11px] uppercase leading-[1.8] tracking-[0.14em] text-[#71717A]\" data-kid=\"1-2-5-1-1-1-3\" data-name=\"formats by source note\">DOCX, PPTX, XLSX → PDF / PDF → DOCX, JPG, PNG / JPG, JPEG, PNG → PDF</p>\n</div>\n<div class=\"border-t border-[#09090B26] pt-6\" data-kid=\"1-2-5-1-1-2\" data-name=\"questions column\">\n<h2 class=\"text-[22px] font-normal tracking-[-0.02em]\" data-kid=\"1-2-5-1-1-2-1\" data-name=\"questions column heading\">Questions</h2>\n<dl class=\"mt-5\" data-kid=\"1-2-5-1-1-2-2\" data-name=\"questions definition list\">\n<div class=\"border-b border-[#09090B1A] pb-4\" data-kid=\"1-2-5-1-1-2-2-1\" data-name=\"question item one\">\n<dt class=\"text-[13.5px] font-medium\" data-kid=\"1-2-5-1-1-2-2-1-1\" data-name=\"question one prompt\">Are my files uploaded anywhere?</dt>\n<dd class=\"mt-1.5 text-[12.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-1-2-2-1-2\" data-name=\"question one answer\">No. Validation runs locally and no request is made. There is no queue and no stored copy.</dd>\n</div>\n<div class=\"border-b border-[#09090B1A] py-4\" data-kid=\"1-2-5-1-1-2-2-2\" data-name=\"question item two\">\n<dt class=\"text-[13.5px] font-medium\" data-kid=\"1-2-5-1-1-2-2-2-1\" data-name=\"question two prompt\">Why doesn't Convert produce a download?</dt>\n<dd class=\"mt-1.5 text-[12.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-1-2-2-2-2\" data-name=\"question two answer\">The engine isn't integrated yet. Convert reports that in one line rather than faking progress.</dd>\n</div>\n<div class=\"border-b border-[#09090B1A] py-4\" data-kid=\"1-2-5-1-1-2-2-3\" data-name=\"question item three\">\n<dt class=\"text-[13.5px] font-medium\" data-kid=\"1-2-5-1-1-2-2-3-1\" data-name=\"question three prompt\">What counts as a valid file?</dt>\n<dd class=\"mt-1.5 text-[12.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-1-2-2-3-2\" data-name=\"question three answer\">DOCX, PDF, JPG, JPEG, PNG, XLSX or PPTX up to 25 MB. Both rules live in one module.</dd>\n</div>\n<div class=\"pt-4\" data-kid=\"1-2-5-1-1-2-2-4\" data-name=\"question item four\">\n<dt class=\"text-[13.5px] font-medium\" data-kid=\"1-2-5-1-1-2-2-4-1\" data-name=\"question four prompt\">Do I need an account?</dt>\n<dd class=\"mt-1.5 text-[12.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-1-2-2-4-2\" data-name=\"question four answer\">No sign-up and nothing to buy. The only limits are the size cap and the format list.</dd>\n</div>\n</dl>\n</div>\n</div>\n</div>\n</section>\n</main>\n<!-- Footer -->\n<footer data-kid=\"1-3\" data-name=\"site footer\">\n<div class=\"mx-auto max-w-[1128px] px-6 py-10\" data-kid=\"1-3-1\" data-name=\"footer inner container\">\n<div class=\"flex flex-col gap-8 md:flex-row md:items-start md:justify-between\" data-kid=\"1-3-1-1\" data-name=\"footer top layout\">\n<div data-kid=\"1-3-1-1-1\" data-name=\"footer brand block\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1-1-1\" data-name=\"footer brand logo row\">\n<span aria-hidden=\"true\" class=\"relative block h-[20px] w-[20px]\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"file icon mark container\">\n<span class=\"absolute left-0 top-[3px] block h-[14px] w-[11px] border border-[#09090B66]\" data-kid=\"1-3-1-1-1-1-1-1\" data-name=\"file icon back document outline\"></span>\n<span class=\"absolute left-[8px] top-0 block h-[14px] w-[11px] border-[1.5px] border-[#6D5EF5]\" data-kid=\"1-3-1-1-1-1-1-2\" data-name=\"file icon front document outline\"></span>\n</span>\n<span class=\"text-[14px] font-semibold tracking-[0.01em]\" data-kid=\"1-3-1-1-1-1-2\" data-name=\"brand name text\">FileFlow</span>\n</div>\n<p class=\"mt-3 max-w-[34ch] text-[12.5px] leading-[1.7] text-[#71717A]\" data-kid=\"1-3-1-1-1-2\" data-name=\"footer tagline text\">\n            Your files, one quiet conversion at a time.\n          </p>\n</div>\n<div class=\"flex gap-14\" data-kid=\"1-3-1-1-2\" data-name=\"footer links columns\">\n<div data-kid=\"1-3-1-1-2-1\" data-name=\"footer product links column\">\n<h3 class=\"text-[10.5px] font-medium uppercase tracking-[0.18em] text-[#71717A]\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"product links heading\">Product</h3>\n<ul class=\"mt-3 space-y-2 text-[12.5px]\" data-kid=\"1-3-1-1-2-1-2\" data-name=\"product links list\">\n<li data-kid=\"1-3-1-1-2-1-2-1\" data-name=\"product link convert a file\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-1-2-1-1\" data-name=\"product link convert a file\" href=\"#convert\">Convert a file</a></li>\n<li data-kid=\"1-3-1-1-2-1-2-2\" data-name=\"product link popular conversions\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-1-2-2-1\" data-name=\"product link popular conversions\" href=\"#converters\">Popular conversions</a></li>\n<li data-kid=\"1-3-1-1-2-1-2-3\" data-name=\"product link how it works\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-1-2-3-1\" data-name=\"product link how it works\" href=\"#how-it-works\">How it works</a></li>\n<li data-kid=\"1-3-1-1-2-1-2-4\" data-name=\"product link formats and privacy\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-1-2-4-1\" data-name=\"product link formats and privacy\" href=\"#privacy\">Formats and privacy</a></li>\n</ul>\n</div>\n<div data-kid=\"1-3-1-1-2-2\" data-name=\"footer legal links column\">\n<h3 class=\"text-[10.5px] font-medium uppercase tracking-[0.18em] text-[#71717A]\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"legal links heading\">Legal</h3>\n<ul class=\"mt-3 space-y-2 text-[12.5px]\" data-kid=\"1-3-1-1-2-2-2\" data-name=\"legal links list\">\n<li data-kid=\"1-3-1-1-2-2-2-1\" data-name=\"legal link privacy policy\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-2-2-1-1\" data-name=\"legal link privacy policy\" href=\"/privacy\">Privacy policy</a></li>\n<li data-kid=\"1-3-1-1-2-2-2-2\" data-name=\"legal link terms of use\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-2-2-2-1\" data-name=\"legal link terms of use\" href=\"/terms\">Terms of use</a></li>\n<li data-kid=\"1-3-1-1-2-2-2-3\" data-name=\"legal link contact email\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-2-2-3-1\" data-name=\"legal link contact email\" href=\"mailto:hello@fileflow.app\">hello@fileflow.app</a></li>\n</ul>\n</div>\n</div>\n</div>\n<div class=\"mt-9 flex flex-wrap items-center justify-between gap-3 border-t border-[#09090B26] pt-4 text-[11px] uppercase tracking-[0.13em] text-[#71717A]\" data-kid=\"1-3-1-2\" data-name=\"footer bottom bar\">\n<span data-kid=\"1-3-1-2-1\" data-name=\"footer copyright text\">© 2026 FileFlow</span>\n<span class=\"inline-flex items-center gap-2\" data-kid=\"1-3-1-2-2\" data-name=\"engine status note\">\n<span class=\"h-1.5 w-1.5 bg-[#09090B4D]\" data-kid=\"1-3-1-2-2-1\" data-name=\"status dot indicator\"></span>\n          Conversion engine not connected\n        </span>\n</div>\n</div>\n</footer>\n</div>",
