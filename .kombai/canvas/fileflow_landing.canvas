    "var_8d5086ee861c": {
      "type": "variant",
      "label": "FileFlow — Proof Sheet, refined palette",
      "parentId": "var_238dc053b62e",
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n</style>\n<div class=\"min-h-screen bg-white text-[#09090B] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: Inter, ui-sans-serif, system-ui, sans-serif;\">\n<!-- Navbar: hairline, sharp -->\n<header class=\"border-b border-[#09090B26] bg-white\" data-kid=\"1-1\" data-name=\"site header\">\n<div class=\"mx-auto flex h-[64px] max-w-[1128px] items-stretch px-6\" data-kid=\"1-1-1\" data-name=\"header inner bar\">\n<a class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"#top\">\n<span aria-hidden=\"true\" class=\"relative block h-[20px] w-[20px]\" data-kid=\"1-1-1-1-1\" data-name=\"logo mark container\">\n<span class=\"absolute left-0 top-[3px] block h-[14px] w-[11px] border border-[#09090B66]\" data-kid=\"1-1-1-1-1-1\" data-name=\"logo mark gray outline box\"></span>\n<span class=\"absolute left-[8px] top-0 block h-[14px] w-[11px] border-[1.5px] border-[#6D5EF5]\" data-kid=\"1-1-1-1-1-2\" data-name=\"logo mark violet filled box\"></span>\n</span>\n<span class=\"text-[14px] font-semibold tracking-[0.01em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">FileFlow</span>\n</a>\n<nav aria-label=\"Main\" class=\"ml-10 hidden items-stretch gap-8 md:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation link group\">\n<a aria-current=\"page\" class=\"flex items-center border-b-2 border-[#6D5EF5] text-[13px] font-medium focus-visible:outline-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-1-2-1\" data-name=\"nav link - active home page\" href=\"#top\">Home</a>\n<a class=\"flex items-center border-b-2 border-transparent text-[13px] text-[#71717A] transition-colors hover:border-[#6D5EF566] hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-1-2-2\" data-name=\"nav link to converters section\" href=\"#converters\">Converters</a>\n<a class=\"flex items-center border-b-2 border-transparent text-[13px] text-[#71717A] transition-colors hover:border-[#6D5EF566] hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-1-2-3\" data-name=\"nav link to how it works section\" href=\"#how-it-works\">How it works</a>\n</nav>\n<div class=\"ml-auto flex items-center gap-5\" data-kid=\"1-1-1-3\" data-name=\"header actions wrapper\">\n<span class=\"hidden text-[12px] uppercase tracking-[0.14em] text-[#71717A] sm:block\" data-kid=\"1-1-1-3-1\" data-name=\"supported formats label\">Seven formats</span>\n<a class=\"border border-[#09090B] px-3.5 py-2 text-[12.5px] font-medium transition-colors hover:border-[#6D5EF5] hover:bg-[#6D5EF5] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-1-3-2\" data-name=\"primary convert CTA button link\" href=\"#convert\">Start converting</a>\n</div>\n</div>\n</header>\n<main data-kid=\"1-2\" data-name=\"main content\" id=\"top\">\n<!-- Hero: proof sheet + violet wash -->\n<section class=\"relative border-b border-[#09090B26]\" data-kid=\"1-2-1\" data-name=\"hero section with violet wash\">\n<div class=\"pointer-events-none absolute inset-x-0 -top-44 h-[660px] bg-[radial-gradient(58%_52%_at_50%_30%,rgba(109,94,245,0.10),rgba(109,94,245,0.028)_58%,rgba(109,94,245,0)_80%)]\" data-kid=\"1-2-1-1\" data-name=\"hero decorative radial gradient\"></div>\n<div class=\"relative mx-auto max-w-[1128px] px-6 pb-16 pt-14\" data-kid=\"1-2-1-2\" data-name=\"hero content container\">\n<div class=\"mx-auto max-w-[820px] text-center\" data-kid=\"1-2-1-2-1\" data-name=\"hero copy block\">\n<p class=\"inline-block border border-[#6D5EF54D] bg-[#6D5EF50A] px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.22em] text-[#5B4CE0]\" data-kid=\"1-2-1-2-1-1\" data-name=\"hero eyebrow badge\">Simple file conversion</p>\n<h1 class=\"mx-auto mt-7 max-w-[20ch] text-[46px] font-normal leading-[1.02] tracking-[-0.045em] sm:text-[66px]\" data-kid=\"1-2-1-2-1-2\" data-name=\"hero headline\">\n            Your files, in the right format.\n          </h1>\n<p class=\"mx-auto mt-6 max-w-[58ch] text-[15.5px] leading-[1.65] text-[#52525B]\" data-kid=\"1-2-1-2-1-3\" data-name=\"hero support paragraph\">\n            One file in, one file out. FileFlow reads the extension, shows the conversions that exist for it, and refuses everything else before it reaches the engine.\n          </p>\n</div>\n<!-- Double keyline frame with registration ticks -->\n<div class=\"relative mx-auto mt-12 max-w-[720px]\" data-kid=\"1-2-1-2-2\" data-name=\"upload sheet frame\">\n<div class=\"pointer-events-none absolute -inset-x-24 -top-8 bottom-6 bg-[radial-gradient(46%_56%_at_50%_45%,rgba(109,94,245,0.11),rgba(109,94,245,0.025)_60%,transparent_78%)]\" data-kid=\"1-2-1-2-2-1\" data-name=\"upload sheet glow effect\"></div>\n<div class=\"relative\" data-kid=\"1-2-1-2-2-2\" data-name=\"keyline frame with registration ticks\">\n<span aria-hidden=\"true\" class=\"absolute -left-[5px] -top-[5px] block h-[10px] w-[10px] border-l border-t border-[#09090B]\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"top-left registration tick\"></span>\n<span aria-hidden=\"true\" class=\"absolute -right-[5px] -top-[5px] block h-[10px] w-[10px] border-r border-t border-[#09090B]\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"top-right registration tick\"></span>\n<span aria-hidden=\"true\" class=\"absolute -bottom-[5px] -left-[5px] block h-[10px] w-[10px] border-b border-l border-[#09090B]\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"bottom-left registration tick\"></span>\n<span aria-hidden=\"true\" class=\"absolute -bottom-[5px] -right-[5px] block h-[10px] w-[10px] border-b border-r border-[#09090B]\" data-kid=\"1-2-1-2-2-2-4\" data-name=\"bottom-right registration tick\"></span>\n<div class=\"border border-[#09090B99] bg-white p-[5px]\" data-kid=\"1-2-1-2-2-2-5\" data-name=\"upload sheet card border\">\n<section aria-labelledby=\"proof-upload-label\" class=\"border border-[#09090B26] px-8 py-11\" data-kid=\"1-2-1-2-2-2-5-1\" data-name=\"file upload sheet section\" id=\"convert\">\n<h2 class=\"sr-only\" data-kid=\"1-2-1-2-2-2-5-1-1\" data-name=\"upload sheet screen-reader heading\" id=\"proof-upload-label\">Upload a file to convert</h2>\n<div class=\"flex flex-col items-center text-center\" data-kid=\"1-2-1-2-2-2-5-1-2\" data-name=\"upload empty state content\">\n<span class=\"inline-block text-[26px] font-light leading-none text-[#6D5EF5]\" data-kid=\"1-2-1-2-2-2-5-1-2-1\" data-name=\"violet plus icon container\"><i aria-hidden=\"true\" class=\"icon-plus\" data-kid=\"1-2-1-2-2-2-5-1-2-1-1\" data-name=\"add file plus icon\"></i></span>\n<p class=\"mt-4 text-[16px] font-medium tracking-[-0.01em]\" data-kid=\"1-2-1-2-2-2-5-1-2-2\" data-name=\"empty state status text\">Nothing selected</p>\n<p class=\"mt-2 max-w-[42ch] text-[13px] leading-[1.65] text-[#71717A]\" data-kid=\"1-2-1-2-2-2-5-1-2-3\" data-name=\"empty state drag instructions\">\n                    Drag a file onto this sheet, or choose one from your device. It stays in the browser until you convert.\n                  </p>\n<div class=\"mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-3\" data-kid=\"1-2-1-2-2-2-5-1-2-4\" data-name=\"upload actions bar\">\n<button class=\"border border-[#6D5EF5] bg-[#6D5EF5] px-4 py-2.5 text-[12.5px] font-medium text-white shadow-[0_10px_22px_-12px_rgba(109,94,245,0.85)] transition-colors hover:border-[#5B4CE0] hover:bg-[#5B4CE0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4B3DD4]\" data-kid=\"1-2-1-2-2-2-5-1-2-4-1\" data-name=\"choose file button\" type=\"button\">\n                      Choose file\n                    </button>\n<span class=\"flex flex-wrap items-center justify-center gap-1.5\" data-kid=\"1-2-1-2-2-2-5-1-2-4-2\" data-name=\"supported format badges list\">\n<span class=\"rounded-[2px] border border-blue-100 bg-blue-50 px-1.5 py-[3px] text-[9.5px] font-semibold tracking-[0.09em] text-blue-700\" data-kid=\"1-2-1-2-2-2-5-1-2-4-2-1\" data-name=\"DOCX format badge\">DOCX</span>\n<span class=\"rounded-[2px] border border-red-100 bg-red-50 px-1.5 py-[3px] text-[9.5px] font-semibold tracking-[0.09em] text-red-700\" data-kid=\"1-2-1-2-2-2-5-1-2-4-2-2\" data-name=\"PDF format badge\">PDF</span>\n<span class=\"rounded-[2px] border border-amber-100 bg-amber-50 px-1.5 py-[3px] text-[9.5px] font-semibold tracking-[0.09em] text-amber-700\" data-kid=\"1-2-1-2-2-2-5-1-2-4-2-3\" data-name=\"JPG format badge\">JPG</span>\n<span class=\"rounded-[2px] border border-amber-100 bg-amber-50 px-1.5 py-[3px] text-[9.5px] font-semibold tracking-[0.09em] text-amber-700\" data-kid=\"1-2-1-2-2-2-5-1-2-4-2-4\" data-name=\"JPEG format badge\">JPEG</span>\n<span class=\"rounded-[2px] border border-teal-100 bg-teal-50 px-1.5 py-[3px] text-[9.5px] font-semibold tracking-[0.09em] text-teal-700\" data-kid=\"1-2-1-2-2-2-5-1-2-4-2-5\" data-name=\"PNG format badge\">PNG</span>\n<span class=\"rounded-[2px] border border-emerald-100 bg-emerald-50 px-1.5 py-[3px] text-[9.5px] font-semibold tracking-[0.09em] text-emerald-700\" data-kid=\"1-2-1-2-2-2-5-1-2-4-2-6\" data-name=\"XLSX format badge\">XLSX</span>\n<span class=\"rounded-[2px] border border-orange-100 bg-orange-50 px-1.5 py-[3px] text-[9.5px] font-semibold tracking-[0.09em] text-orange-700\" data-kid=\"1-2-1-2-2-2-5-1-2-4-2-7\" data-name=\"PPTX format badge\">PPTX</span>\n</span>\n</div>\n</div>\n<div class=\"mt-8 flex items-center gap-4 border-t border-[#09090B1A] pt-4 text-[11px] uppercase tracking-[0.12em] text-[#71717A]\" data-kid=\"1-2-1-2-2-2-5-1-3\" data-name=\"upload sheet footer meta\">\n<span data-kid=\"1-2-1-2-2-2-5-1-3-1\" data-name=\"max size constraint text\">Max 25 MB</span>\n<span class=\"h-3 w-px bg-[#09090B26]\" data-kid=\"1-2-1-2-2-2-5-1-3-2\" data-name=\"vertical divider\"></span>\n<span data-kid=\"1-2-1-2-2-2-5-1-3-3\" data-name=\"no account constraint text\">No account</span>\n<span class=\"h-3 w-px bg-[#09090B26]\" data-kid=\"1-2-1-2-2-2-5-1-3-4\" data-name=\"vertical divider\"></span>\n<span class=\"text-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-5-1-3-5\" data-name=\"target format note\" data-reason=\"text replaced by file selection script after file is picked\">Target format appears after selection</span>\n</div>\n</section>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Popular conversions: ruled agenda list with semantic badges -->\n<section class=\"border-b border-[#09090B26] bg-white\" data-kid=\"1-2-2\" data-name=\"popular conversions section\" id=\"converters\">\n<div class=\"mx-auto max-w-[1128px] px-6 py-14\" data-kid=\"1-2-2-1\" data-name=\"conversions section inner container\">\n<div class=\"flex flex-wrap items-baseline justify-between gap-3\" data-kid=\"1-2-2-1-1\" data-name=\"section header row\">\n<h2 class=\"text-[22px] font-normal tracking-[-0.02em]\" data-kid=\"1-2-2-1-1-1\" data-name=\"section title\">Popular conversions</h2>\n<p class=\"text-[12px] uppercase tracking-[0.14em] text-[#71717A]\" data-kid=\"1-2-2-1-1-2\" data-name=\"section description text\">Each row is a rule in the converter</p>\n</div>\n<ul class=\"mt-7 border-t border-[#09090B26]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2\" data-name=\"conversions list\" data-reason=\"rows interact with upload sheet (set target format) via click handlers\">\n<li data-kid=\"1-2-2-1-2-1\" data-name=\"conversion row list item\">\n<a class=\"group flex items-center gap-5 border-b border-[#09090B1A] px-2 py-3.5 transition-colors hover:bg-[#6D5EF508] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"DOCX to PDF conversion row link\" data-reason=\"click sets target format in upload sheet\" href=\"#convert\">\n<span class=\"flex w-[62px] justify-start\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"source format cell\">\n<span class=\"rounded-[2px] border border-blue-100 bg-blue-50 px-1.5 py-[3px] text-[10px] font-semibold tracking-[0.08em] text-blue-700\" data-kid=\"1-2-2-1-2-1-1-1-1\" data-name=\"DOCX source format badge\">DOCX</span>\n</span>\n<span class=\"hidden w-[120px] text-[11.5px] text-[#A1A1AA] sm:block\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"format description label\">Word document</span>\n<span aria-hidden=\"true\" class=\"h-px flex-1 bg-[#09090B26] transition-colors group-hover:bg-[#6D5EF580]\" data-kid=\"1-2-2-1-2-1-1-3\" data-name=\"connecting rule line\"></span>\n<span class=\"flex w-[62px] justify-end\" data-kid=\"1-2-2-1-2-1-1-4\" data-name=\"target format cell\">\n<span class=\"rounded-[2px] border border-red-100 bg-red-50 px-1.5 py-[3px] text-[10px] font-semibold tracking-[0.08em] text-red-700\" data-kid=\"1-2-2-1-2-1-1-4-1\" data-name=\"PDF target format badge\">PDF</span>\n</span>\n<span aria-hidden=\"true\" class=\"w-4 text-[12px] text-transparent transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-2-2-1-2-1-1-5\" data-name=\"arrow reveal container\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-1-1-5-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-2\" data-name=\"conversion row list item\">\n<a class=\"group flex items-center gap-5 border-b border-[#09090B1A] px-2 py-3.5 transition-colors hover:bg-[#6D5EF508] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"PDF to DOCX conversion row link\" data-reason=\"click sets target format in upload sheet\" href=\"#convert\">\n<span class=\"flex w-[62px] justify-start\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"source format cell\">\n<span class=\"rounded-[2px] border border-red-100 bg-red-50 px-1.5 py-[3px] text-[10px] font-semibold tracking-[0.08em] text-red-700\" data-kid=\"1-2-2-1-2-2-1-1-1\" data-name=\"PDF source format badge\">PDF</span>\n</span>\n<span class=\"hidden w-[120px] text-[11.5px] text-[#A1A1AA] sm:block\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"format description label\">Portable document</span>\n<span aria-hidden=\"true\" class=\"h-px flex-1 bg-[#09090B26] transition-colors group-hover:bg-[#6D5EF580]\" data-kid=\"1-2-2-1-2-2-1-3\" data-name=\"connecting rule line\"></span>\n<span class=\"flex w-[62px] justify-end\" data-kid=\"1-2-2-1-2-2-1-4\" data-name=\"target format cell\">\n<span class=\"rounded-[2px] border border-blue-100 bg-blue-50 px-1.5 py-[3px] text-[10px] font-semibold tracking-[0.08em] text-blue-700\" data-kid=\"1-2-2-1-2-2-1-4-1\" data-name=\"DOCX target format badge\">DOCX</span>\n</span>\n<span aria-hidden=\"true\" class=\"w-4 text-[12px] text-transparent transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-2-2-1-2-2-1-5\" data-name=\"arrow reveal container\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-2-1-5-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-3\" data-name=\"conversion row list item\">\n<a class=\"group flex items-center gap-5 border-b border-[#09090B1A] px-2 py-3.5 transition-colors hover:bg-[#6D5EF508] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"JPG to PDF conversion row link\" data-reason=\"click sets target format in upload sheet\" href=\"#convert\">\n<span class=\"flex w-[62px] justify-start\" data-kid=\"1-2-2-1-2-3-1-1\" data-name=\"source format cell\">\n<span class=\"rounded-[2px] border border-amber-100 bg-amber-50 px-1.5 py-[3px] text-[10px] font-semibold tracking-[0.08em] text-amber-700\" data-kid=\"1-2-2-1-2-3-1-1-1\" data-name=\"JPG source format badge\">JPG</span>\n</span>\n<span class=\"hidden w-[120px] text-[11.5px] text-[#A1A1AA] sm:block\" data-kid=\"1-2-2-1-2-3-1-2\" data-name=\"format description label\">Photo</span>\n<span aria-hidden=\"true\" class=\"h-px flex-1 bg-[#09090B26] transition-colors group-hover:bg-[#6D5EF580]\" data-kid=\"1-2-2-1-2-3-1-3\" data-name=\"connecting rule line\"></span>\n<span class=\"flex w-[62px] justify-end\" data-kid=\"1-2-2-1-2-3-1-4\" data-name=\"target format cell\">\n<span class=\"rounded-[2px] border border-red-100 bg-red-50 px-1.5 py-[3px] text-[10px] font-semibold tracking-[0.08em] text-red-700\" data-kid=\"1-2-2-1-2-3-1-4-1\" data-name=\"PDF target format badge\">PDF</span>\n</span>\n<span aria-hidden=\"true\" class=\"w-4 text-[12px] text-transparent transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-2-2-1-2-3-1-5\" data-name=\"arrow reveal container\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-3-1-5-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-4\" data-name=\"conversion row list item\">\n<a class=\"group flex items-center gap-5 border-b border-[#09090B1A] px-2 py-3.5 transition-colors hover:bg-[#6D5EF508] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"PDF to JPG conversion row link\" data-reason=\"click sets target format in upload sheet\" href=\"#convert\">\n<span class=\"flex w-[62px] justify-start\" data-kid=\"1-2-2-1-2-4-1-1\" data-name=\"source format cell\">\n<span class=\"rounded-[2px] border border-red-100 bg-red-50 px-1.5 py-[3px] text-[10px] font-semibold tracking-[0.08em] text-red-700\" data-kid=\"1-2-2-1-2-4-1-1-1\" data-name=\"PDF source format badge\">PDF</span>\n</span>\n<span class=\"hidden w-[120px] text-[11.5px] text-[#A1A1AA] sm:block\" data-kid=\"1-2-2-1-2-4-1-2\" data-name=\"format description label\">Portable document</span>\n<span aria-hidden=\"true\" class=\"h-px flex-1 bg-[#09090B26] transition-colors group-hover:bg-[#6D5EF580]\" data-kid=\"1-2-2-1-2-4-1-3\" data-name=\"connecting rule line\"></span>\n<span class=\"flex w-[62px] justify-end\" data-kid=\"1-2-2-1-2-4-1-4\" data-name=\"target format cell\">\n<span class=\"rounded-[2px] border border-amber-100 bg-amber-50 px-1.5 py-[3px] text-[10px] font-semibold tracking-[0.08em] text-amber-700\" data-kid=\"1-2-2-1-2-4-1-4-1\" data-name=\"JPG target format badge\">JPG</span>\n</span>\n<span aria-hidden=\"true\" class=\"w-4 text-[12px] text-transparent transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-2-2-1-2-4-1-5\" data-name=\"arrow reveal container\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-4-1-5-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-5\" data-name=\"conversion row list item\">\n<a class=\"group flex items-center gap-5 border-b border-[#09090B1A] px-2 py-3.5 transition-colors hover:bg-[#6D5EF508] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-5-1\" data-name=\"XLSX to PDF conversion row link\" data-reason=\"click sets target format in upload sheet\" href=\"#convert\">\n<span class=\"flex w-[62px] justify-start\" data-kid=\"1-2-2-1-2-5-1-1\" data-name=\"source format cell\">\n<span class=\"rounded-[2px] border border-emerald-100 bg-emerald-50 px-1.5 py-[3px] text-[10px] font-semibold tracking-[0.08em] text-emerald-700\" data-kid=\"1-2-2-1-2-5-1-1-1\" data-name=\"XLSX source format badge\">XLSX</span>\n</span>\n<span class=\"hidden w-[120px] text-[11.5px] text-[#A1A1AA] sm:block\" data-kid=\"1-2-2-1-2-5-1-2\" data-name=\"format description label\">Spreadsheet</span>\n<span aria-hidden=\"true\" class=\"h-px flex-1 bg-[#09090B26] transition-colors group-hover:bg-[#6D5EF580]\" data-kid=\"1-2-2-1-2-5-1-3\" data-name=\"connecting rule line\"></span>\n<span class=\"flex w-[62px] justify-end\" data-kid=\"1-2-2-1-2-5-1-4\" data-name=\"target format cell\">\n<span class=\"rounded-[2px] border border-red-100 bg-red-50 px-1.5 py-[3px] text-[10px] font-semibold tracking-[0.08em] text-red-700\" data-kid=\"1-2-2-1-2-5-1-4-1\" data-name=\"PDF target format badge\">PDF</span>\n</span>\n<span aria-hidden=\"true\" class=\"w-4 text-[12px] text-transparent transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-2-2-1-2-5-1-5\" data-name=\"arrow reveal container\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-5-1-5-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-6\" data-name=\"conversion row list item\">\n<a class=\"group flex items-center gap-5 border-b border-[#09090B26] px-2 py-3.5 transition-colors hover:bg-[#6D5EF508] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-6-1\" data-name=\"PPTX to PDF conversion row link\" data-reason=\"click sets target format in upload sheet\" href=\"#convert\">\n<span class=\"flex w-[62px] justify-start\" data-kid=\"1-2-2-1-2-6-1-1\" data-name=\"source format cell\">\n<span class=\"rounded-[2px] border border-orange-100 bg-orange-50 px-1.5 py-[3px] text-[10px] font-semibold tracking-[0.08em] text-orange-700\" data-kid=\"1-2-2-1-2-6-1-1-1\" data-name=\"PPTX source format badge\">PPTX</span>\n</span>\n<span class=\"hidden w-[120px] text-[11.5px] text-[#A1A1AA] sm:block\" data-kid=\"1-2-2-1-2-6-1-2\" data-name=\"format description label\">Slide deck</span>\n<span aria-hidden=\"true\" class=\"h-px flex-1 bg-[#09090B26] transition-colors group-hover:bg-[#6D5EF580]\" data-kid=\"1-2-2-1-2-6-1-3\" data-name=\"connecting rule line\"></span>\n<span class=\"flex w-[62px] justify-end\" data-kid=\"1-2-2-1-2-6-1-4\" data-name=\"target format cell\">\n<span class=\"rounded-[2px] border border-red-100 bg-red-50 px-1.5 py-[3px] text-[10px] font-semibold tracking-[0.08em] text-red-700\" data-kid=\"1-2-2-1-2-6-1-4-1\" data-name=\"PDF target format badge\">PDF</span>\n</span>\n<span aria-hidden=\"true\" class=\"w-4 text-[12px] text-transparent transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-2-2-1-2-6-1-5\" data-name=\"arrow reveal container\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-6-1-5-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</li>\n</ul>\n<p class=\"mt-4 text-[12px] text-[#71717A]\" data-kid=\"1-2-2-1-3\" data-name=\"conversions section footnote\">Selecting a row sets that target format in the upload sheet above.</p>\n</div>\n</section>\n<!-- How it works: zinc band -->\n<section class=\"border-b border-[#09090B26] bg-zinc-50\" data-kid=\"1-2-3\" data-name=\"how it works section\" id=\"how-it-works\">\n<div class=\"mx-auto max-w-[1128px] px-6 py-14\" data-kid=\"1-2-3-1\" data-name=\"how it works inner container\">\n<div class=\"flex flex-wrap items-baseline justify-between gap-3\" data-kid=\"1-2-3-1-1\" data-name=\"section header row\">\n<h2 class=\"text-[22px] font-normal tracking-[-0.02em]\" data-kid=\"1-2-3-1-1-1\" data-name=\"section title\">How it works</h2>\n<p class=\"text-[12px] uppercase tracking-[0.14em] text-[#71717A]\" data-kid=\"1-2-3-1-1-2\" data-name=\"section description text\">Three moves, no wizard</p>\n</div>\n<div class=\"mt-10 grid grid-cols-3 gap-10\" data-kid=\"1-2-3-1-2\" data-name=\"steps grid\">\n<div data-kid=\"1-2-3-1-2-1\" data-name=\"step 1 card container\">\n<span class=\"block text-[68px] font-extralight leading-[0.8] tracking-[-0.05em] text-[#6D5EF54D]\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"step number watermark\">01</span>\n<h3 class=\"-mt-2 text-[16px] font-medium tracking-[-0.01em]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"step title\">Select a file</h3>\n<p class=\"mt-2.5 max-w-[32ch] text-[13px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"step description\">\n              Drop it on the sheet or use the picker. One file, up to 25 MB, from the seven supported formats.\n            </p>\n</div>\n<div data-kid=\"1-2-3-1-2-2\" data-name=\"step 2 card container\">\n<span class=\"block text-[68px] font-extralight leading-[0.8] tracking-[-0.05em] text-[#6D5EF54D]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"step number watermark\">02</span>\n<h3 class=\"-mt-2 text-[16px] font-medium tracking-[-0.01em]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"step title\">Choose the target</h3>\n<p class=\"mt-2.5 max-w-[32ch] text-[13px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"step description\">\n              The extension is read on selection. Only targets that exist for that source are offered — nothing aspirational.\n            </p>\n</div>\n<div data-kid=\"1-2-3-1-2-3\" data-name=\"step 3 card container\">\n<span class=\"block text-[68px] font-extralight leading-[0.8] tracking-[-0.05em] text-[#6D5EF54D]\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"step number watermark\">03</span>\n<h3 class=\"-mt-2 text-[16px] font-medium tracking-[-0.01em]\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"step title\">Convert</h3>\n<p class=\"mt-2.5 max-w-[32ch] text-[13px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"step description\">\n              The engine is not connected, so the action reports that in one line. No progress bar, no placeholder download.\n            </p>\n</div>\n</div>\n</div>\n</section>\n<!-- Formats ticker tape: semantically tinted tokens -->\n<section class=\"overflow-hidden border-b border-[#09090B26] bg-white\" data-kid=\"1-2-4\" data-name=\"formats ticker tape section\">\n<div class=\"flex items-center gap-0 whitespace-nowrap py-3.5\" data-kid=\"1-2-4-1\" data-name=\"ticker items wrapper\">\n<span class=\"shrink-0 border-r border-[#09090B26] px-5 text-[10.5px] font-medium uppercase tracking-[0.2em] text-[#6D5EF5]\" data-kid=\"1-2-4-1-1\" data-name=\"ticker supported label\">Supported</span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-blue-700\" data-kid=\"1-2-4-1-2\" data-name=\"DOCX ticker item\">DOCX</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-3\" data-name=\"ticker vertical divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-red-700\" data-kid=\"1-2-4-1-4\" data-name=\"PDF ticker item\">PDF</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-5\" data-name=\"ticker vertical divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-amber-700\" data-kid=\"1-2-4-1-6\" data-name=\"JPG ticker item\">JPG</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-7\" data-name=\"ticker vertical divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-amber-700\" data-kid=\"1-2-4-1-8\" data-name=\"JPEG ticker item\">JPEG</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-9\" data-name=\"ticker vertical divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-teal-700\" data-kid=\"1-2-4-1-10\" data-name=\"PNG ticker item\">PNG</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-11\" data-name=\"ticker vertical divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-emerald-700\" data-kid=\"1-2-4-1-12\" data-name=\"XLSX ticker item\">XLSX</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-13\" data-name=\"ticker vertical divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-orange-700\" data-kid=\"1-2-4-1-14\" data-name=\"PPTX ticker item\">PPTX</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-15\" data-name=\"ticker vertical divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#09090B]\" data-kid=\"1-2-4-1-16\" data-name=\"max size ticker note\">25 MB max</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-17\" data-name=\"ticker vertical divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-[#09090B]\" data-kid=\"1-2-4-1-18\" data-name=\"no files stored ticker note\">No files stored</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-19\" data-name=\"ticker vertical divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-blue-700\" data-kid=\"1-2-4-1-20\" data-name=\"DOCX ticker item false\">DOCX</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-21\" data-name=\"ticker vertical divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-red-700\" data-kid=\"1-2-4-1-22\" data-name=\"PDF ticker item\">PDF</span>\n<span class=\"h-3 w-px bg-[#09090B1A]\" data-kid=\"1-2-4-1-23\" data-name=\"ticker vertical divider\"></span>\n<span class=\"px-5 text-[11px] uppercase tracking-[0.2em] text-amber-700\" data-kid=\"1-2-4-1-24\" data-name=\"JPG ticker item\">JPG</span>\n</div>\n</section>\n<!-- Privacy + FAQ -->\n<section class=\"border-b border-[#09090B26] bg-white\" data-kid=\"1-2-5\" data-name=\"privacy and faq section\" id=\"privacy\">\n<div class=\"mx-auto max-w-[1128px] px-6 py-14\" data-kid=\"1-2-5-1\" data-name=\"privacy and faq inner container\">\n<div class=\"grid grid-cols-1 gap-12 md:grid-cols-[1fr_1.1fr] md:gap-16\" data-kid=\"1-2-5-1-1\" data-name=\"privacy and faq grid\">\n<div class=\"border-t border-[#09090B26] pt-6\" data-kid=\"1-2-5-1-1-1\" data-name=\"privacy block\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-2-5-1-1-1-1\" data-name=\"privacy heading with icon\">\n<span class=\"text-[17px] text-[#6D5EF5]\" data-kid=\"1-2-5-1-1-1-1-1\" data-name=\"violet shield icon container\"><i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-5-1-1-1-1-1-1\" data-name=\"shield check icon\"></i></span>\n<h2 class=\"text-[17px] font-medium tracking-[-0.01em]\" data-kid=\"1-2-5-1-1-1-1-2\" data-name=\"privacy block title\">Privacy, stated plainly</h2>\n</div>\n<p class=\"mt-3 max-w-[46ch] text-[13px] leading-[1.75] text-[#52525B]\" data-kid=\"1-2-5-1-1-1-2\" data-name=\"privacy paragraph\">\n              File selection and format checks run in the browser. Nothing is sent to a server, queued, or retained, because there is no conversion service connected yet. When there is, your file travels only for the duration of the job.\n            </p>\n<ul class=\"mt-5 space-y-2 text-[11px]\" data-kid=\"1-2-5-1-1-1-3\" data-name=\"format group list\">\n<li class=\"flex flex-wrap items-center gap-1.5\" data-kid=\"1-2-5-1-1-1-3-1\" data-name=\"documents format group row\">\n<span class=\"rounded-[2px] border border-blue-100 bg-blue-50 px-1 py-[2px] text-[9.5px] font-semibold tracking-[0.08em] text-blue-700\" data-kid=\"1-2-5-1-1-1-3-1-1\" data-name=\"DOCX badge\">DOCX</span>\n<span class=\"rounded-[2px] border border-orange-100 bg-orange-50 px-1 py-[2px] text-[9.5px] font-semibold tracking-[0.08em] text-orange-700\" data-kid=\"1-2-5-1-1-1-3-1-2\" data-name=\"PPTX badge\">PPTX</span>\n<span class=\"rounded-[2px] border border-emerald-100 bg-emerald-50 px-1 py-[2px] text-[9.5px] font-semibold tracking-[0.08em] text-emerald-700\" data-kid=\"1-2-5-1-1-1-3-1-3\" data-name=\"XLSX badge\">XLSX</span>\n<span class=\"px-0.5 text-[#A1A1AA]\" data-kid=\"1-2-5-1-1-1-3-1-4\" data-name=\"arrow separator\">→</span>\n<span class=\"rounded-[2px] border border-red-100 bg-red-50 px-1 py-[2px] text-[9.5px] font-semibold tracking-[0.08em] text-red-700\" data-kid=\"1-2-5-1-1-1-3-1-5\" data-name=\"PDF badge\">PDF</span>\n<span class=\"ml-1 uppercase tracking-[0.12em] text-[#71717A]\" data-kid=\"1-2-5-1-1-1-3-1-6\" data-name=\"group label\">documents</span>\n</li>\n<li class=\"flex flex-wrap items-center gap-1.5\" data-kid=\"1-2-5-1-1-1-3-2\" data-name=\"scans and exports format group row\">\n<span class=\"rounded-[2px] border border-red-100 bg-red-50 px-1 py-[2px] text-[9.5px] font-semibold tracking-[0.08em] text-red-700\" data-kid=\"1-2-5-1-1-1-3-2-1\" data-name=\"PDF badge\">PDF</span>\n<span class=\"px-0.5 text-[#A1A1AA]\" data-kid=\"1-2-5-1-1-1-3-2-2\" data-name=\"arrow separator\">→</span>\n<span class=\"rounded-[2px] border border-amber-100 bg-amber-50 px-1 py-[2px] text-[9.5px] font-semibold tracking-[0.08em] text-amber-700\" data-kid=\"1-2-5-1-1-1-3-2-3\" data-name=\"JPG badge\">JPG</span>\n<span class=\"rounded-[2px] border border-teal-100 bg-teal-50 px-1 py-[2px] text-[9.5px] font-semibold tracking-[0.08em] text-teal-700\" data-kid=\"1-2-5-1-1-1-3-2-4\" data-name=\"PNG badge\">PNG</span>\n<span class=\"rounded-[2px] border border-blue-100 bg-blue-50 px-1 py-[2px] text-[9.5px] font-semibold tracking-[0.08em] text-blue-700\" data-kid=\"1-2-5-1-1-1-3-2-5\" data-name=\"DOCX badge\">DOCX</span>\n<span class=\"ml-1 uppercase tracking-[0.12em] text-[#71717A]\" data-kid=\"1-2-5-1-1-1-3-2-6\" data-name=\"group label\">scans and exports</span>\n</li>\n<li class=\"flex flex-wrap items-center gap-1.5\" data-kid=\"1-2-5-1-1-1-3-3\" data-name=\"images format group row\">\n<span class=\"rounded-[2px] border border-amber-100 bg-amber-50 px-1 py-[2px] text-[9.5px] font-semibold tracking-[0.08em] text-amber-700\" data-kid=\"1-2-5-1-1-1-3-3-1\" data-name=\"JPG badge\">JPG</span>\n<span class=\"rounded-[2px] border border-teal-100 bg-teal-50 px-1 py-[2px] text-[9.5px] font-semibold tracking-[0.08em] text-teal-700\" data-kid=\"1-2-5-1-1-1-3-3-2\" data-name=\"PNG badge\">PNG</span>\n<span class=\"px-0.5 text-[#A1A1AA]\" data-kid=\"1-2-5-1-1-1-3-3-3\" data-name=\"arrow separator\">→</span>\n<span class=\"rounded-[2px] border border-red-100 bg-red-50 px-1 py-[2px] text-[9.5px] font-semibold tracking-[0.08em] text-red-700\" data-kid=\"1-2-5-1-1-1-3-3-4\" data-name=\"PDF badge\">PDF</span>\n<span class=\"ml-1 uppercase tracking-[0.12em] text-[#71717A]\" data-kid=\"1-2-5-1-1-1-3-3-5\" data-name=\"group label\">images</span>\n</li>\n</ul>\n</div>\n<div class=\"border-t border-[#09090B26] pt-6\" data-kid=\"1-2-5-1-1-2\" data-name=\"faq block\">\n<h2 class=\"text-[22px] font-normal tracking-[-0.02em]\" data-kid=\"1-2-5-1-1-2-1\" data-name=\"faq title\">Questions</h2>\n<dl class=\"mt-5\" data-kid=\"1-2-5-1-1-2-2\" data-name=\"faq list\">\n<div class=\"border-b border-[#09090B1A] pb-4\" data-kid=\"1-2-5-1-1-2-2-1\" data-name=\"faq item\">\n<dt class=\"text-[13.5px] font-medium\" data-kid=\"1-2-5-1-1-2-2-1-1\" data-name=\"faq question\">Are my files uploaded anywhere?</dt>\n<dd class=\"mt-1.5 text-[12.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-1-2-2-1-2\" data-name=\"faq answer\">No. Validation runs locally and no request is made. There is no queue and no stored copy.</dd>\n</div>\n<div class=\"border-b border-[#09090B1A] py-4\" data-kid=\"1-2-5-1-1-2-2-2\" data-name=\"faq item\">\n<dt class=\"text-[13.5px] font-medium\" data-kid=\"1-2-5-1-1-2-2-2-1\" data-name=\"faq question\">Why doesn't Convert produce a download?</dt>\n<dd class=\"mt-1.5 text-[12.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-1-2-2-2-2\" data-name=\"faq answer\">The engine isn't integrated yet. Convert reports that in one line rather than faking progress.</dd>\n</div>\n<div class=\"border-b border-[#09090B1A] py-4\" data-kid=\"1-2-5-1-1-2-2-3\" data-name=\"faq item\">\n<dt class=\"text-[13.5px] font-medium\" data-kid=\"1-2-5-1-1-2-2-3-1\" data-name=\"faq question\">What counts as a valid file?</dt>\n<dd class=\"mt-1.5 text-[12.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-1-2-2-3-2\" data-name=\"faq answer\">DOCX, PDF, JPG, JPEG, PNG, XLSX or PPTX up to 25 MB. Both rules live in one module.</dd>\n</div>\n<div class=\"pt-4\" data-kid=\"1-2-5-1-1-2-2-4\" data-name=\"faq item\">\n<dt class=\"text-[13.5px] font-medium\" data-kid=\"1-2-5-1-1-2-2-4-1\" data-name=\"faq question\">Do I need an account?</dt>\n<dd class=\"mt-1.5 text-[12.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-1-2-2-4-2\" data-name=\"faq answer\">No sign-up and nothing to buy. The only limits are the size cap and the format list.</dd>\n</div>\n</dl>\n</div>\n</div>\n</div>\n</section>\n</main>\n<!-- Footer -->\n<footer class=\"bg-zinc-50\" data-kid=\"1-3\" data-name=\"page footer\">\n<div class=\"mx-auto max-w-[1128px] px-6 py-10\" data-kid=\"1-3-1\" data-name=\"footer inner container\">\n<div class=\"flex flex-col gap-8 md:flex-row md:items-start md:justify-between\" data-kid=\"1-3-1-1\" data-name=\"footer main content row\">\n<div data-kid=\"1-3-1-1-1\" data-name=\"footer brand column\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1-1-1\" data-name=\"footer logo block\">\n<span aria-hidden=\"true\" class=\"relative block h-[20px] w-[20px]\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"footer logo mark container\">\n<span class=\"absolute left-0 top-[3px] block h-[14px] w-[11px] border border-[#09090B66]\" data-kid=\"1-3-1-1-1-1-1-1\" data-name=\"footer logo mark gray outline box\"></span>\n<span class=\"absolute left-[8px] top-0 block h-[14px] w-[11px] border-[1.5px] border-[#6D5EF5]\" data-kid=\"1-3-1-1-1-1-1-2\" data-name=\"footer logo mark violet filled box\"></span>\n</span>\n<span class=\"text-[14px] font-semibold tracking-[0.01em]\" data-kid=\"1-3-1-1-1-1-2\" data-name=\"footer brand name\">FileFlow</span>\n</div>\n<p class=\"mt-3 max-w-[34ch] text-[12.5px] leading-[1.7] text-[#71717A]\" data-kid=\"1-3-1-1-1-2\" data-name=\"footer tagline\">\n            Your files, one quiet conversion at a time.\n          </p>\n</div>\n<div class=\"flex gap-14\" data-kid=\"1-3-1-1-2\" data-name=\"footer link columns\">\n<div data-kid=\"1-3-1-1-2-1\" data-name=\"product links column\">\n<h3 class=\"text-[10.5px] font-medium uppercase tracking-[0.18em] text-[#71717A]\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"product heading\">Product</h3>\n<ul class=\"mt-3 space-y-2 text-[12.5px]\" data-kid=\"1-3-1-1-2-1-2\" data-name=\"product links list\">\n<li data-kid=\"1-3-1-1-2-1-2-1\" data-name=\"product list item\"><a class=\"text-[#52525B] transition-colors hover:text-[#6D5EF5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-1-2-1-1\" data-name=\"convert a file link\" href=\"#convert\">Convert a file</a></li>\n<li data-kid=\"1-3-1-1-2-1-2-2\" data-name=\"product list item\"><a class=\"text-[#52525B] transition-colors hover:text-[#6D5EF5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outl