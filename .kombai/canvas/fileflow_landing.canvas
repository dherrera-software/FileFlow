      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n</style>\n<div class=\"min-h-screen bg-white text-[#09090B] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: Inter, ui-sans-serif, system-ui, sans-serif;\">\n<!-- ── Navbar ─────────────────────────────────────────── -->\n<header class=\"border-b border-[#E4E4E7]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-[68px] max-w-[1120px] items-center gap-9 px-6\" data-kid=\"1-1-1\" data-name=\"header content container\">\n<a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#top\">\n<span aria-hidden=\"true\" class=\"relative block h-[22px] w-[22px]\" data-kid=\"1-1-1-1-1\" data-name=\"overlapping cards logo mark\">\n<span class=\"absolute left-0 top-[4px] block h-[15px] w-[12px] rounded-[3px] border border-[#09090B4D]\" data-kid=\"1-1-1-1-1-1\" data-name=\"back card shape of logo\"></span>\n<span class=\"absolute left-[9px] top-0 block h-[15px] w-[12px] rounded-[3px] border-[1.5px] border-[#6D5EF5]\" data-kid=\"1-1-1-1-1-2\" data-name=\"front card shape of logo\"></span>\n</span>\n<span class=\"text-[15px] font-semibold tracking-[-0.015em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">FileFlow</span>\n</a>\n<nav aria-label=\"Main\" class=\"hidden items-center gap-7 text-[13.5px] md:flex\" data-kid=\"1-1-1-2\" data-name=\"primary navigation\">\n<a aria-current=\"page\" class=\"relative font-medium text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-1-2-1\" data-name=\"active navigation link with underline\" href=\"#top\">\n          Home\n          <span class=\"absolute -bottom-[25px] left-0 h-[2px] w-full bg-[#6D5EF5]\" data-kid=\"1-1-1-2-1-1\" data-name=\"active link underline bar\"></span>\n</a>\n<a class=\"text-[#71717A] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-1-2-2\" data-name=\"converters navigation link\" href=\"#converters\">Converters</a>\n<a class=\"text-[#71717A] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-1-2-3\" data-name=\"how it works navigation link\" href=\"#how-it-works\">How it works</a>\n</nav>\n<div class=\"ml-auto flex items-center gap-4\" data-kid=\"1-1-1-3\" data-name=\"header actions container\">\n<span class=\"hidden text-[12.5px] text-[#71717A] sm:block\" data-kid=\"1-1-1-3-1\" data-name=\"no account needed tagline\">No account needed</span>\n<a class=\"rounded-md border border-[#E4E4E7] px-3.5 py-2 text-[13px] font-medium transition-colors hover:border-[#09090B33] hover:bg-[#FAFAFA] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-1-1-3-2\" data-name=\"start converting button\" href=\"#convert\">Start converting</a>\n</div>\n</div>\n</header>\n<main data-kid=\"1-2\" data-name=\"main content region\" id=\"top\">\n<!-- ── Hero + upload ───────────────────────────────── -->\n<section class=\"relative overflow-hidden border-b border-[#E4E4E7]\" data-kid=\"1-2-1\" data-name=\"hero section\">\n<div class=\"pointer-events-none absolute inset-x-0 -top-40 mx-auto h-[460px] max-w-[900px] bg-[radial-gradient(50%_58%_at_50%_42%,rgba(109,94,245,0.11),rgba(109,94,245,0.025)_58%,transparent_76%)]\" data-kid=\"1-2-1-1\" data-name=\"decorative radial gradient glow\"></div>\n<div class=\"relative mx-auto max-w-[1120px] px-6 pb-16 pt-[70px]\" data-kid=\"1-2-1-2\" data-name=\"hero content container\">\n<div class=\"mx-auto max-w-[760px] text-center\" data-kid=\"1-2-1-2-1\" data-name=\"hero text block\">\n<p class=\"text-[10.5px] font-semibold uppercase tracking-[0.2em] text-[#71717A]\" data-kid=\"1-2-1-2-1-1\" data-name=\"hero eyebrow label\">Simple file conversion</p>\n<h1 class=\"mt-5 text-[42px] font-medium leading-[1.03] tracking-[-0.035em] sm:text-[58px]\" data-kid=\"1-2-1-2-1-2\" data-name=\"hero headline\">\n            Your files, in the right format.\n          </h1>\n<p class=\"mx-auto mt-5 max-w-[56ch] text-[16px] leading-[1.6] text-[#52525B]\" data-kid=\"1-2-1-2-1-3\" data-name=\"hero description text\">\n            Drop a document, a scan, or a slide deck. FileFlow reads the source format and offers only the targets that can actually open it.\n          </p>\n</div>\n<!-- Upload card — empty state -->\n<section aria-labelledby=\"upload-label\" class=\"mx-auto mt-10 max-w-[660px]\" data-kid=\"1-2-1-2-2\" data-name=\"file upload card section\" id=\"convert\">\n<h2 class=\"sr-only\" data-kid=\"1-2-1-2-2-1\" data-name=\"screen reader upload heading\" id=\"upload-label\">Upload a file to convert</h2>\n<div class=\"rounded-lg border border-[#E4E4E7] bg-white p-1.5 shadow-[0_1px_2px_rgba(9,9,11,0.04),0_18px_40px_-32px_rgba(9,9,11,0.35)]\" data-kid=\"1-2-1-2-2-2\" data-name=\"upload card container\">\n<div class=\"rounded-md border border-dashed border-[#D4D4D8] bg-[#FAFAFA] px-6 py-9 text-center\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"drag and drop zone\">\n<span class=\"inline-block text-[22px] text-[#52525B]\" data-kid=\"1-2-1-2-2-2-1-1\" data-name=\"upload cloud icon wrapper\"><i aria-hidden=\"true\" class=\"icon-upload-cloud\" data-kid=\"1-2-1-2-2-2-1-1-1\" data-name=\"upload cloud icon\"></i></span>\n<p class=\"mt-3 text-[15px] font-medium\" data-kid=\"1-2-1-2-2-2-1-2\" data-name=\"drop file prompt text\">Drop a file here</p>\n<p class=\"mt-1 text-[13px] leading-[1.55] text-[#71717A]\" data-kid=\"1-2-1-2-2-2-1-3\" data-name=\"file picker hint text\">\n                or pick one from your device. Nothing is uploaded until you convert.\n              </p>\n<div class=\"mt-5 flex flex-wrap items-center justify-center gap-3\" data-kid=\"1-2-1-2-2-2-1-4\" data-name=\"upload actions row\">\n<button class=\"rounded-md bg-[#09090B] px-4 py-2.5 text-[13px] font-medium text-white transition-colors hover:bg-[#27272A] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-1-2-2-2-1-4-1\" data-name=\"choose file button\" type=\"button\">\n                  Choose file\n                </button>\n<span class=\"text-[12px] text-[#71717A]\" data-kid=\"1-2-1-2-2-2-1-4-2\" data-name=\"supported formats hint\">DOCX, PDF, JPG, JPEG, PNG, XLSX, PPTX</span>\n</div>\n</div>\n<div class=\"flex flex-wrap items-center justify-between gap-2 px-4 pb-1 pt-3 text-[12px] text-[#71717A]\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"upload card footer row\">\n<span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"file size limit indicator\">\n<span class=\"text-[13px] text-[#A1A1AA]\" data-kid=\"1-2-1-2-2-2-2-1-1\" data-name=\"info icon wrapper\"><i aria-hidden=\"true\" class=\"icon-info\" data-kid=\"1-2-1-2-2-2-2-1-1-1\" data-name=\"info icon\"></i></span>\n                25 MB per file\n              </span>\n<span data-kid=\"1-2-1-2-2-2-2-2\" data-name=\"target format status note\">Target format appears once a file is selected</span>\n</div>\n</div>\n</section>\n</div>\n</section>\n<!-- ── Popular conversions ─────────────────────────── -->\n<section class=\"border-b border-[#E4E4E7]\" data-kid=\"1-2-2\" data-name=\"popular conversions section\" id=\"converters\">\n<div class=\"mx-auto max-w-[1120px] px-6 py-14\" data-kid=\"1-2-2-1\" data-name=\"conversions section container\">\n<div class=\"flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-2-2-1-1\" data-name=\"section heading row\">\n<div data-kid=\"1-2-2-1-1-1\" data-name=\"section heading block\">\n<h2 class=\"text-[20px] font-semibold tracking-[-0.015em]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"section heading title\">Popular conversions</h2>\n<p class=\"mt-1.5 text-[13.5px] text-[#71717A]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"section heading subtitle\">Choosing one sets the target format in the upload card.</p>\n</div>\n<a class=\"inline-flex items-center gap-1.5 text-[13px] font-medium text-[#6D5EF5] transition-colors hover:text-[#4B3DD4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-1-2\" data-name=\"all supported pairs link\" href=\"#privacy\">\n            All supported pairs\n            <span class=\"text-[13px]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"arrow icon wrapper\"><i aria-hidden=\"true\" class=\"icon-arrow-right\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"right arrow icon\"></i></span>\n</a>\n</div>\n<ul class=\"mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3\" data-kid=\"1-2-2-1-2\" data-name=\"conversion pairs grid\">\n<li data-kid=\"1-2-2-1-2-1\" data-name=\"conversion pair grid item\">\n<a class=\"group flex items-center justify-between rounded-md border border-[#E4E4E7] px-4 py-3.5 transition-colors hover:border-[#09090B33] hover:bg-[#FAFAFA] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"DOCX to PDF conversion link\" href=\"#convert\">\n<span class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"format pair display\">\n<span class=\"text-[12.5px] font-semibold tracking-[0.07em]\" data-kid=\"1-2-2-1-2-1-1-1-1\" data-name=\"source format label\">DOCX</span>\n<span aria-hidden=\"true\" class=\"text-[12px] text-[#A1A1AA]\" data-kid=\"1-2-2-1-2-1-1-1-2\" data-name=\"direction arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-1-1-1-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"text-[12.5px] font-semibold tracking-[0.07em]\" data-kid=\"1-2-2-1-2-1-1-1-3\" data-name=\"target format label\">PDF</span>\n</span>\n<span aria-hidden=\"true\" class=\"text-[12px] text-[#A1A1AA] transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"add indicator icon wrapper\"><i class=\"icon-plus\" data-kid=\"1-2-2-1-2-1-1-2-1\" data-name=\"plus icon\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-2\" data-name=\"conversion pair grid item\">\n<a class=\"group flex items-center justify-between rounded-md border border-[#E4E4E7] px-4 py-3.5 transition-colors hover:border-[#09090B33] hover:bg-[#FAFAFA] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"PDF to DOCX conversion link\" href=\"#convert\">\n<span class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"format pair display\">\n<span class=\"text-[12.5px] font-semibold tracking-[0.07em]\" data-kid=\"1-2-2-1-2-2-1-1-1\" data-name=\"source format label\">PDF</span>\n<span aria-hidden=\"true\" class=\"text-[12px] text-[#A1A1AA]\" data-kid=\"1-2-2-1-2-2-1-1-2\" data-name=\"direction arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-2-1-1-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"text-[12.5px] font-semibold tracking-[0.07em]\" data-kid=\"1-2-2-1-2-2-1-1-3\" data-name=\"target format label\">DOCX</span>\n</span>\n<span aria-hidden=\"true\" class=\"text-[12px] text-[#A1A1AA] transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"add indicator icon wrapper\"><i class=\"icon-plus\" data-kid=\"1-2-2-1-2-2-1-2-1\" data-name=\"plus icon\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-3\" data-name=\"conversion pair grid item\">\n<a class=\"group flex items-center justify-between rounded-md border border-[#E4E4E7] px-4 py-3.5 transition-colors hover:border-[#09090B33] hover:bg-[#FAFAFA] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"JPG to PDF conversion link\" href=\"#convert\">\n<span class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2-3-1-1\" data-name=\"format pair display\">\n<span class=\"text-[12.5px] font-semibold tracking-[0.07em]\" data-kid=\"1-2-2-1-2-3-1-1-1\" data-name=\"source format label\">JPG</span>\n<span aria-hidden=\"true\" class=\"text-[12px] text-[#A1A1AA]\" data-kid=\"1-2-2-1-2-3-1-1-2\" data-name=\"direction arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-3-1-1-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"text-[12.5px] font-semibold tracking-[0.07em]\" data-kid=\"1-2-2-1-2-3-1-1-3\" data-name=\"target format label\">PDF</span>\n</span>\n<span aria-hidden=\"true\" class=\"text-[12px] text-[#A1A1AA] transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-2-2-1-2-3-1-2\" data-name=\"add indicator icon wrapper\"><i class=\"icon-plus\" data-kid=\"1-2-2-1-2-3-1-2-1\" data-name=\"plus icon\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-4\" data-name=\"conversion pair grid item\">\n<a class=\"group flex items-center justify-between rounded-md border border-[#E4E4E7] px-4 py-3.5 transition-colors hover:border-[#09090B33] hover:bg-[#FAFAFA] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"PDF to JPG conversion link\" href=\"#convert\">\n<span class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2-4-1-1\" data-name=\"format pair display\">\n<span class=\"text-[12.5px] font-semibold tracking-[0.07em]\" data-kid=\"1-2-2-1-2-4-1-1-1\" data-name=\"source format label\">PDF</span>\n<span aria-hidden=\"true\" class=\"text-[12px] text-[#A1A1AA]\" data-kid=\"1-2-2-1-2-4-1-1-2\" data-name=\"direction arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-4-1-1-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"text-[12.5px] font-semibold tracking-[0.07em]\" data-kid=\"1-2-2-1-2-4-1-1-3\" data-name=\"target format label\">JPG</span>\n</span>\n<span aria-hidden=\"true\" class=\"text-[12px] text-[#A1A1AA] transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-2-2-1-2-4-1-2\" data-name=\"add indicator icon wrapper\"><i class=\"icon-plus\" data-kid=\"1-2-2-1-2-4-1-2-1\" data-name=\"plus icon\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-5\" data-name=\"conversion pair grid item\">\n<a class=\"group flex items-center justify-between rounded-md border border-[#E4E4E7] px-4 py-3.5 transition-colors hover:border-[#09090B33] hover:bg-[#FAFAFA] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-2-5-1\" data-name=\"XLSX to PDF conversion link\" href=\"#convert\">\n<span class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2-5-1-1\" data-name=\"format pair display\">\n<span class=\"text-[12.5px] font-semibold tracking-[0.07em]\" data-kid=\"1-2-2-1-2-5-1-1-1\" data-name=\"source format label\">XLSX</span>\n<span aria-hidden=\"true\" class=\"text-[12px] text-[#A1A1AA]\" data-kid=\"1-2-2-1-2-5-1-1-2\" data-name=\"direction arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-5-1-1-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"text-[12.5px] font-semibold tracking-[0.07em]\" data-kid=\"1-2-2-1-2-5-1-1-3\" data-name=\"target format label\">PDF</span>\n</span>\n<span aria-hidden=\"true\" class=\"text-[12px] text-[#A1A1AA] transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-2-2-1-2-5-1-2\" data-name=\"add indicator icon wrapper\"><i class=\"icon-plus\" data-kid=\"1-2-2-1-2-5-1-2-1\" data-name=\"plus icon\"></i></span>\n</a>\n</li>\n<li data-kid=\"1-2-2-1-2-6\" data-name=\"conversion pair grid item\">\n<a class=\"group flex items-center justify-between rounded-md border border-[#E4E4E7] px-4 py-3.5 transition-colors hover:border-[#09090B33] hover:bg-[#FAFAFA] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-2-2-1-2-6-1\" data-name=\"PPTX to PDF conversion link\" href=\"#convert\">\n<span class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2-6-1-1\" data-name=\"format pair display\">\n<span class=\"text-[12.5px] font-semibold tracking-[0.07em]\" data-kid=\"1-2-2-1-2-6-1-1-1\" data-name=\"source format label\">PPTX</span>\n<span aria-hidden=\"true\" class=\"text-[12px] text-[#A1A1AA]\" data-kid=\"1-2-2-1-2-6-1-1-2\" data-name=\"direction arrow icon wrapper\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-1-2-6-1-1-2-1\" data-name=\"right arrow icon\"></i></span>\n<span class=\"text-[12.5px] font-semibold tracking-[0.07em]\" data-kid=\"1-2-2-1-2-6-1-1-3\" data-name=\"target format label\">PDF</span>\n</span>\n<span aria-hidden=\"true\" class=\"text-[12px] text-[#A1A1AA] transition-colors group-hover:text-[#6D5EF5]\" data-kid=\"1-2-2-1-2-6-1-2\" data-name=\"add indicator icon wrapper\"><i class=\"icon-plus\" data-kid=\"1-2-2-1-2-6-1-2-1\" data-name=\"plus icon\"></i></span>\n</a>\n</li>\n</ul>\n</div>\n</section>\n<!-- ── How it works ────────────────────────────────── -->\n<section class=\"border-b border-[#E4E4E7] bg-[#FAFAFA]\" data-kid=\"1-2-3\" data-name=\"how it works section\" id=\"how-it-works\">\n<div class=\"mx-auto max-w-[1120px] px-6 py-14\" data-kid=\"1-2-3-1\" data-name=\"how it works container\">\n<h2 class=\"text-[20px] font-semibold tracking-[-0.015em]\" data-kid=\"1-2-3-1-1\" data-name=\"section heading\">How it works</h2>\n<div class=\"mt-8 grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-0 md:divide-x md:divide-[#E4E4E7]\" data-kid=\"1-2-3-1-2\" data-name=\"steps grid\">\n<div class=\"md:pr-8\" data-kid=\"1-2-3-1-2-1\" data-name=\"step one column\">\n<p class=\"text-[11px] font-semibold tracking-[0.16em] text-[#6D5EF5]\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"step number label\">01</p>\n<h3 class=\"mt-3 text-[15px] font-semibold\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"step title\">Select a file</h3>\n<p class=\"mt-2 max-w-[34ch] text-[13.5px] leading-[1.65] text-[#52525B]\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"step description\">\n              Drag it onto the drop area or use the picker. Up to 25 MB, and only the seven formats on the supported list.\n            </p>\n</div>\n<div class=\"md:px-8\" data-kid=\"1-2-3-1-2-2\" data-name=\"step two column\">\n<p class=\"text-[11px] font-semibold tracking-[0.16em] text-[#6D5EF5]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"step number label\">02</p>\n<p class=\"mt-3 text-[15px] font-semibold\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"step title\">Pick the target</p>\n<p class=\"mt-2 text-[13.5px] leading-[1.6] text-[#52525B]\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"step description\">\n              The source format is detected from the extension, and only conversions that exist for it are listed.\n            </p>\n</div>\n<div class=\"md:pl-8\" data-kid=\"1-2-3-1-2-3\" data-name=\"step three column\">\n<p class=\"text-[11px] font-semibold tracking-[0.16em] text-[#6D5EF5]\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"step number label\">03</p>\n<p class=\"mt-3 text-[15px] font-semibold\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"step title\">Convert</p>\n<p class=\"mt-2 text-[13.5px] leading-[1.6] text-[#52525B]\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"step description\">\n              The engine is not connected yet, so the Convert action says so plainly instead of drawing a progress bar that never finishes.\n            </p>\n</div>\n</div>\n</div>\n</section>\n<!-- ── Privacy + formats band ──────────────────────── -->\n<section class=\"border-b border-[#E4E4E7]\" data-kid=\"1-2-4\" data-name=\"privacy and formats section\" id=\"privacy\">\n<div class=\"mx-auto grid max-w-[1120px] grid-cols-1 gap-8 px-6 py-10 md:grid-cols-[minmax(0,420px)_1px_1fr] md:gap-10\" data-kid=\"1-2-4-1\" data-name=\"privacy section container\">\n<div class=\"flex gap-3.5\" data-kid=\"1-2-4-1-1\" data-name=\"privacy statement block\">\n<span class=\"mt-0.5 text-[18px] text-[#6D5EF5]\" data-kid=\"1-2-4-1-1-1\" data-name=\"shield icon wrapper\"><i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"shield check icon\"></i></span>\n<div data-kid=\"1-2-4-1-1-2\" data-name=\"privacy text content\">\n<h2 class=\"text-[15px] font-semibold\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"privacy heading\">Privacy, stated plainly</h2>\n<p class=\"mt-2 text-[13px] leading-[1.65] text-[#52525B]\" data-kid=\"1-2-4-1-1-2-2\" data-name=\"privacy explanation text\">\n              Selecting and checking a file happens in your browser. No upload request is made, nothing is queued, and no file is retained — because the conversion engine is not wired up yet. When it is, files will be sent for the job and nothing else.\n            </p>\n</div>\n</div>\n<div aria-hidden=\"true\" class=\"hidden bg-[#E4E4E7] md:block\" data-kid=\"1-2-4-1-2\" data-name=\"vertical divider line\"></div>\n<div data-kid=\"1-2-4-1-3\" data-name=\"supported formats block\">\n<h3 class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#71717A]\" data-kid=\"1-2-4-1-3-1\" data-name=\"formats subheading\">Supported source formats</h3>\n<p class=\"mt-3 text-[13.5px] leading-[1.8] text-[#09090B]\" data-kid=\"1-2-4-1-3-2\" data-name=\"supported format list\">\n            DOCX, PDF, JPG, JPEG, PNG, XLSX, PPTX\n          </p>\n<p class=\"mt-3 text-[13px] leading-[1.7] text-[#71717A]\" data-kid=\"1-2-4-1-3-3\" data-name=\"format pairing rules text\">\n            DOCX, PPTX and XLSX export to PDF. PDF exports to DOCX, JPG or PNG. JPG, JPEG and PNG export to PDF. Anything else is rejected before it reaches the converter.\n          </p>\n</div>\n</div>\n</section>\n<!-- ── FAQ ────────────────────────────────────────── -->\n<section class=\"border-b border-[#E4E4E7]\" data-kid=\"1-2-5\" data-name=\"FAQ section\">\n<div class=\"mx-auto grid max-w-[1120px] grid-cols-1 gap-8 px-6 py-14 md:grid-cols-[240px_1fr] md:gap-16\" data-kid=\"1-2-5-1\" data-name=\"FAQ container\">\n<div data-kid=\"1-2-5-1-1\" data-name=\"question column\">\n<h2 class=\"text-[20px] font-semibold tracking-[-0.015em]\" data-kid=\"1-2-5-1-1-1\" data-name=\"FAQ heading\">Questions</h2>\n<p class=\"mt-2 text-[13px] leading-[1.6] text-[#71717A]\" data-kid=\"1-2-5-1-1-2\" data-name=\"FAQ subtitle\">The ones people ask before trusting a file tool.</p>\n</div>\n<dl class=\"divide-y divide-[#E4E4E7] border-t border-[#E4E4E7]\" data-kid=\"1-2-5-1-2\" data-name=\"questions list\">\n<div class=\"py-5\" data-kid=\"1-2-5-1-2-1\" data-name=\"FAQ item\">\n<dt class=\"text-[14px] font-medium\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"question text\">Are my files uploaded anywhere?</dt>\n<dd class=\"mt-2 max-w-[68ch] text-[13.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-2-1-2\" data-name=\"answer text\">\n              No. Choosing a file and validating it against the supported list runs entirely in the browser. There is no network request, no queue and no stored copy.\n            </dd>\n</div>\n<div class=\"py-5\" data-kid=\"1-2-5-1-2-2\" data-name=\"FAQ item\">\n<dt class=\"text-[14px] font-medium\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"question text\">Why doesn't Convert produce a download?</dt>\n<dd class=\"mt-2 max-w-[68ch] text-[13.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-2-2-2\" data-name=\"answer text\">\n              The conversion engine is still to be integrated. Pressing Convert shows a notice saying exactly that, so the flow, the states and the labels are real before the backend exists.\n            </dd>\n</div>\n<div class=\"py-5\" data-kid=\"1-2-5-1-2-3\" data-name=\"FAQ item\">\n<dt class=\"text-[14px] font-medium\" data-kid=\"1-2-5-1-2-3-1\" data-name=\"question text\">What counts as a valid file?</dt>\n<dd class=\"mt-2 max-w-[68ch] text-[13.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-2-3-2\" data-name=\"answer text\">\n              DOCX, PDF, JPG, JPEG, PNG, XLSX or PPTX, up to 25 MB. Both rules live in one module, so a change there updates the dropzone, the error message and the target options together.\n            </dd>\n</div>\n<div class=\"py-5\" data-kid=\"1-2-5-1-2-4\" data-name=\"FAQ item\">\n<dt class=\"text-[14px] font-medium\" data-kid=\"1-2-5-1-2-4-1\" data-name=\"question text\">Can I convert to any format I like?</dt>\n<dd class=\"mt-2 max-w-[68ch] text-[13.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-2-4-2\" data-name=\"answer text\">\n              No. Only pairs that exist for your source are offered. A DOCX can become a PDF; a PDF can become a DOCX, JPG or PNG. That is the whole rule set.\n            </dd>\n</div>\n<div class=\"py-5\" data-kid=\"1-2-5-1-2-5\" data-name=\"FAQ item\">\n<dt class=\"text-[14px] font-medium\" data-kid=\"1-2-5-1-2-5-1\" data-name=\"question text\">Do I need an account?</dt>\n<dd class=\"mt-2 max-w-[68ch] text-[13.5px] leading-[1.7] text-[#52525B]\" data-kid=\"1-2-5-1-2-5-2\" data-name=\"answer text\">\n              No sign-up, no plan, nothing to buy. The only limits are the file size cap and the format list.\n            </dd>\n</div>\n</dl>\n</div>\n</section>\n</main>\n<!-- ── Footer ─────────────────────────────────────────── -->\n<footer class=\"bg-white\" data-kid=\"1-3\" data-name=\"site footer\">\n<div class=\"mx-auto max-w-[1120px] px-6 py-12\" data-kid=\"1-3-1\" data-name=\"footer content container\">\n<div class=\"flex flex-col gap-10 md:flex-row md:justify-between\" data-kid=\"1-3-1-1\" data-name=\"footer top section\">\n<div class=\"max-w-[280px]\" data-kid=\"1-3-1-1-1\" data-name=\"footer brand block\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"1-3-1-1-1-1\" data-name=\"footer logo container\">\n<span aria-hidden=\"true\" class=\"relative block h-[22px] w-[22px]\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"overlapping cards logo mark\">\n<span class=\"absolute left-0 top-[4px] block h-[15px] w-[12px] rounded-[3px] border border-[#09090B4D]\" data-kid=\"1-3-1-1-1-1-1-1\" data-name=\"back card shape of logo\"></span>\n<span class=\"absolute left-[9px] top-0 block h-[15px] w-[12px] rounded-[3px] border-[1.5px] border-[#6D5EF5]\" data-kid=\"1-3-1-1-1-1-1-2\" data-name=\"front card shape of logo\"></span>\n</span>\n<span class=\"text-[15px] font-semibold tracking-[-0.015em]\" data-kid=\"1-3-1-1-1-1-2\" data-name=\"brand name text\">FileFlow</span>\n</div>\n<p class=\"mt-3 text-[13px] leading-[1.65] text-[#71717A]\" data-kid=\"1-3-1-1-1-2\" data-name=\"footer tagline text\">Your files, in the right format. Built to be honest about what it can do today.</p>\n</div>\n<div class=\"flex gap-16\" data-kid=\"1-3-1-1-2\" data-name=\"footer links container\">\n<div data-kid=\"1-3-1-1-2-1\" data-name=\"product links column\">\n<h3 class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#71717A]\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"product link heading\">Product</h3>\n<ul class=\"mt-3 space-y-2.5 text-[13px]\" data-kid=\"1-3-1-1-2-1-2\" data-name=\"product links list\">\n<li data-kid=\"1-3-1-1-2-1-2-1\" data-name=\"product list item\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-1-2-1-1\" data-name=\"convert a file link\" href=\"#convert\">Convert a file</a></li>\n<li data-kid=\"1-3-1-1-2-1-2-2\" data-name=\"product list item\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-1-2-2-1\" data-name=\"popular conversions link\" href=\"#converters\">Popular conversions</a></li>\n<li data-kid=\"1-3-1-1-2-1-2-3\" data-name=\"product list item\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-1-2-3-1\" data-name=\"how it works link\" href=\"#how-it-works\">How it works</a></li>\n<li data-kid=\"1-3-1-1-2-1-2-4\" data-name=\"product list item\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-1-2-4-1\" data-name=\"supported formats link\" href=\"#privacy\">Supported formats</a></li>\n</ul>\n</div>\n<div data-kid=\"1-3-1-1-2-2\" data-name=\"legal links column\">\n<h3 class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#71717A]\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"legal link heading\">Legal</h3>\n<ul class=\"mt-3 space-y-2.5 text-[13px]\" data-kid=\"1-3-1-1-2-2-2\" data-name=\"legal links list\">\n<li data-kid=\"1-3-1-1-2-2-2-1\" data-name=\"legal list item\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-2-2-1-1\" data-name=\"privacy policy link\" href=\"/privacy\">Privacy policy</a></li>\n<li data-kid=\"1-3-1-1-2-2-2-2\" data-name=\"legal list item\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-2-2-2-1\" data-name=\"terms of use link\" href=\"/terms\">Terms of use</a></li>\n<li data-kid=\"1-3-1-1-2-2-2-3\" data-name=\"legal list item\"><a class=\"text-[#52525B] transition-colors hover:text-[#09090B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6D5EF5]\" data-kid=\"1-3-1-1-2-2-2-3-1\" data-name=\"contact email link\" href=\"mailto:hello@fileflow.app\">hello@fileflow.app</a></li>\n</ul>\n</div>\n</div>\n</div>\n<div class=\"mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-[#E4E4E7] pt-5 text-[12px] text-[#71717A]\" data-kid=\"1-3-1-2\" data-name=\"footer bottom row\">\n<span data-kid=\"1-3-1-2-1\" data-name=\"copyright notice\">© 2026 FileFlow</span>\n<span class=\"inline-flex items-center gap-2\" data-kid=\"1-3-1-2-2\" data-name=\"status indicator\">\n<span class=\"h-1.5 w-1.5 rounded-full bg-[#D4D4D8]\" data-kid=\"1-3-1-2-2-1\" data-name=\"status dot\"></span>\n          Conversion engine not connected\n        </span>\n</div>\n</div>\n</footer>\n</div>",
