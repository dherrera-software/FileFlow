{
  "name": "fileflow-root",
  "version": "1.0.0",
  "private": true,
  "description": "FileFlow root orchestration workspace",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:client": "pnpm --filter fileflow-client dev",
    "dev:server": "pnpm --filter fileflow-server dev",
    "build": "pnpm -r run build",
    "build:client": "pnpm --filter fileflow-client build",
    "build:server": "pnpm --filter fileflow-server build",
    "lint": "pnpm --filter fileflow-client lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["workerd"]
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
