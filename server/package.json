    "@types/turndown": "^5.0.6",
    "adm-zip": "^0.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.2",
    "fluent-ffmpeg": "^2.1.3",
    "heic-convert": "^2.1.0",
    "hono": "^4.13.14",
    "libreoffice-convert": "^1.6.0",
    "marked": "^18.1.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
