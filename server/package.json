{
  "name": "fileflow-server",
  "version": "1.0.0",
  "description": "Production-ready backend for FileFlow file conversion",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx watch src/server.ts",
